{
    "id": "symfony2",
    "name": "Symfony2",
    "media": "symfony2.svg",
    "days": [
        {
            "label":"Jour 1",
            "items": [
                {
                    "title": "Introduction",
                    "duration": 120,
                    "concepts": [
                        "Internet != Le WEB",
                        "Protocole HTTP (RFC2616)",
                        "Quelques frameworks PHP : CodeIgniter, FuelPHP, Zend, CakePHP, Symfony",
                        "Pourquoi Symfony2 ?"
                    ]
                },
                {
                    "title": "UN BON ENVIRONNEMENT ET DE BONNES PRATIQUES",
                    "duration": 120,
                    "concepts": [
                        "Quel IDE",
                        "Utiliser un SCM (SVN, Git, ...)",
                        "Utiliser un bug tracker (Trac, Mantis, Redmine, Github, ...)",
                        "Les conventions de codage"
                    ]
                },
                {
                    "title": "INTRODUCTION AUX DESIGN PATTERN",
                    "duration": 120,
                    "concepts": [
                        "Présentation générale",
                        "Le MVC en détail"
                    ]
                },
                {
                    "title": "LA STRUCTURE DES APPLICATIONS AVEC SYMFONY2",
                    "duration": 120,
                    "concepts": [
                        "La notion \"d'application\" => app/",
                        "La notion de \"bundles\"",
                        "Mon code spécifique => src/",
                        "Les librairies externes => vendor/",
                        "La racine web => web/"
                    ]
                }
            ]
        },
        {
            "label":"Jour 2",
            "items": [
                {
                    "title": "LE CONTROLLER DANS SYMFONY2",
                    "duration": 240,
                    "concepts": [
                        "Object Request",
                        "Object Response",
                        "Le routing",
                        "Les annotations"
                    ]
                },
                {
                    "title": "LES VUES (TEMPLATING) AVEC SYMFONY2",
                    "duration": 240,
                    "concepts": [
                        "Twig",
                        "Héritage de template",
                        "Inclure des vues",
                        "Rendre des vues",
                        "Filtres twig"
                    ]
                }
            ]
        },
        {
            "label":"Jour 3",
            "items": [
                {
                    "title": "ORM ET DBAL (DATABASE ABSTRACTION LAYER)",
                    "duration": 240,
                    "concepts": [
                        "PDO",
                        "Doctrine",
                        "Propel"
                    ]
                },
                {
                    "title": "LES FORMS (FORMULAIRES)",
                    "duration": 240,
                    "concepts": [
                        "AbstractType",
                        "Les champs",
                        "La validation",
                        "Les form events"
                    ]
                }
            ]
        },
        {
            "label":"Jour 4",
            "items": [
                {
                    "title": "Créer un service",
                    "duration": 240,
                    "concepts": [
                        "Injection de dépendance",
                        "Conteneur de service"
                    ]
                },
                {
                    "title": "La sécurité",
                    "duration": 240,
                    "concepts": [
                        "Autorisation",
                        "Authentification"
                    ]
                }
            ]
        },
        {
            "label":"Jour 5",
            "items": [
                {
                    "title": "Les tests",
                    "duration": 240,
                    "concepts": [
                        "Les tests unitaires avec PHPUnit",
                        "Les tests fonctionnels"
                    ]
                },
                {
                    "title": "Aller plus loin",
                    "duration": 240,
                    "concepts": [
                        "Utiliser la configuration",
                        "Créer des commandes Symfony2",
                        "Utiliser des bundles existants",
                        "FOSUserBundle (Gestion des utilisateurs)",
                        "DoctrineFixtures (L'import de données)",
                        "Créer des bundles réutilisables",
                        "Le cache HTTP (ESI, varnish, ...)"
                    ]
                }
            ]
        }
    ]
}