{% extends 'layout.html.twig' %}

{% block main %}

<section class="section-container">
    <section class="section-dynamic-display">
        <h2 class="section-dynamic-display-title idci-title-primary">Blog</h2>
        <h3 class="section-dynamic-display-subtitle idci-subtitle-primary">{% trans from "blog" %}blog.carousel_title{% endtrans %}</h3>


        <div class="columns">
            <div class="pic-ctn">
            {% set article_count = 0 %}
            {% if article_count < 3 %}
                {% for date_label, date in articles %}
                    {% for article in date %}
                        {% if article_count < 3 %}
                            <div class="columns pic">
                                <img src="{{ asset('build/images/base/symfony2.svg') }}" class="column is-3">
                                <div class="column is-6 carousel-article">
                                    <div class="carousel-article-header">
                                        <p>{{ article.parutionDate }}</p>
                                        <p>{{ article.author }}</p>
                                    </div>
                                    <p class="carousel-article-title">{{ article.name }}</p>
                                    <p class="carousel-article-description">{{ article.description }}</p>
                                    <a href="{{ url('app_blog_article', {'slug': article.id}) }}" class="carousel-article-button">{% trans from "blog" %}blog.read_article{% endtrans %}</a>
                                </div>
                            </div>
                            {% set article_count = article_count + 1 %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            {% endif %}
            </div>
        </div>


        <div class="carousel-single-item">
            {% set article_count = 0 %}
            {% if article_count < 3 %}
                {% for date_label, date in articles %}
                    {% for article in date %}
                        {% if article_count < 3 %}
                            <div class="columns">
                                <img src="{{ asset('build/images/base/symfony2.svg') }}" class="column is-3 is-offset-2">
                                <div class="column is-6 is-centered carousel-article">
                                    <div class="carousel-article-header">
                                        <p>{{ article.parutionDate }}</p>
                                        <p>{{ article.author }}</p>
                                    </div>
                                    <p class="carousel-article-title">{{ article.name }}</p>
                                    <p class="carousel-article-description">{{ article.description }}</p>
                                    <a href="{{ url('app_blog_article', {'slug': article.id}) }}" class="carousel-article-button">{% trans from "blog" %}blog.read_article{% endtrans %}</a>
                                </div>
                            </div>
                            {% set article_count = article_count + 1 %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            {% endif %}
        </div>


    </section>
</section>

<section class="section-container section-container-70 section-container-primary">
    <section class="section-articles">
        <h2 class="section-articles-title idci-title-primary">{% trans from "blog" %}blog.all_articles_title{% endtrans %}</h2>
        <div class="tab">
            <div class="tab-item">
                <input type="radio" id="articles_by_dates" name="nav-tab" checked>
                <label for="articles_by_dates" data-position="1">{% trans from "blog" %}blog.by_dates{% endtrans %}</label>
                <div class="tab-pane">
                    {% for date_label, date in articles %}
                    <div class="section-articles-list">
                        <h2 class="section-articles-list-title">{{ date_label }}</h2>
                        <ul>
                            {% for article in date %}
                            <li class="section-articles-list-item">
                                <img src="{{ asset('build/images/' ~ article.media ~ '') }}" class="section-articles-list-item-media">
                                <a href="{{ url('app_blog_article', {'slug': article.id}) }}" class="section-articles-list-item-link">{{ article.name }}</a>
                                <span class="section-articles-list-item-infos">{% trans from "blog" %}blog.uploaded_the{% endtrans %} {{ article.parutionDate }} {% trans from "blog" %}blog.by{% endtrans %} {{ article.author }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="tab-item">
                <input type="radio" id="articles_by_categories" name="nav-tab">
                <label class="label-second" for="articles_by_categories" data-position="2">{% trans from "blog" %}blog.by_categories{% endtrans %}</label>
                <div class="tab-pane">
                    {% for category_label, category in articles_by_categories %}
                    <div class="section-articles-list">
                        <h2 class="section-articles-list-title">{{ category_label }}</h2>
                        <ul>
                            {% for article in category %}
                            <li class="section-articles-list-item">
                                <img src="{{ asset('build/images/' ~ article.media ~ '') }}" class="section-articles-list-item-media">
                                <a href="{{ url('app_blog_article', {'slug': article.id}) }}" class="section-articles-list-item-link">{{ article.name }}</a>
                                <span class="section-articles-list-item-infos">{% trans from "blog" %}blog.uploaded_the{% endtrans %} {{ article.parutionDate }} {% trans from "blog" %}blog.by{% endtrans %} {{ article.author }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
</section>

{% endblock %}