{% extends "layout.html.twig" %}
{% trans_default_domain 'blog' %}

{% block metaTags %}
    {% for tag in metaTags %}
        <meta {{ tag.attributeName }}="{{ tag.attributeValue }}" content="{{ tag.content }}" />
    {% endfor %}
{% endblock %}

{% block nav %}
    {% include 'menu.html.twig' with {
    'menu': menu,
    'active': 'website_blog'
    } %}
{% endblock %}

{% block main_content %}

    <nav class="article-aside-menu">
        <ul>
            {% for link in articleAsideMenu %}
                <li>
                    {{ link|raw }}
                </li>
            {% endfor %}
        </ul>
    </nav>

    <section class="blog-article">
        {{ article|raw }}
    </section>

    <section id="disqus_thread" class="disqus"></section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('h2').forEach(function (h2) {
            h2.id = slugify(h2.innerHTML);
        })
        document.querySelectorAll('h3').forEach(function (h3) {
            h3.id = slugify(h3.innerHTML);
        })
        makeSyntaxHighlighting();
        handleScroll();

        // ---- Disqus ---- //

        var hashCode = function(string) {
        var hash = 0, i, chr, len;
        if (string.length === 0) return hash;
        for (i = 0, len = string.length; i < len; i++) {
            chr   = string.charCodeAt(i);
            hash  = ((hash << 5) - hash) + chr;
            hash |= 0; // Convert to 32bit integer
        }
        return hash;
    };

     var disqus_config = function () {
         this.page.url = "{{ app.request.uri }}"; // Replace PAGE_URL with your page's canonical URL variable
         this.page.identifier = hashCode("{{ app.request.getRequestUri() }}"); // Replace PAGE_IDENTIFIER with your page's unique identifier variable
         this.language = "{{ app.request.locale }}";
     };

    (function() { // DON'T EDIT BELOW THIS LINE
        var d = document, s = d.createElement('script');

        s.src = '//idci.disqus.com/embed.js';

        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
    </script>
{% endblock %}