{% extends 'layout.html.twig' %}

{% block main %}

    {% set locale = app.request.locale %}
    {% trans_default_domain 'blog' %}

    {% include 'widgets/_section_dynamic_display.html.twig' with {
        'page_title': 'Blog',
        'section_title': 'blog.carousel_title'|trans,
        'max_slide': 3,
        'slides': posts,
        'href': 'app_blog_post'
    } %}

    {% include 'widgets/_section_posts.html.twig' with {
        'title': 'blog.all_posts_title'|trans,
        'tabs': [
            {
                'label': 'blog.by_years'|trans,
                'id': 'posts_by_years',
                'items': posts_by_years
            },
            {
                'label': 'blog.by_categories'|trans,
                'id': 'posts_by_categories',
                'items': posts_by_categories
            }
        ],
        'trans_domain': 'blog'
    } %}

{% endblock %}