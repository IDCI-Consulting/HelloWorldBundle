{% extends 'base.html.twig' %}

{% block header %}
    <header class="idci-header">
        <input type="checkbox" id="hamburger-checkbox" />
        <label for="hamburger-checkbox" class="menu-icon">
            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </label>

        <a class="logo" href="{{ url('website_home') }}">
            <img src="{{ asset('build/images/logo_idci.svg') }}" alt="idci logo" title="IDCI Consulting"/>
        </a>

        <nav class="navbar">
            {% block nav %}{% endblock %}
        </nav>

        <div class="langs">
            <p class="choose-language">{% trans %}Choose the language{% endtrans %}</p>
            <ul class="idci-inline-list">
                {% for locale in locales %}
                    <li{% if app.request.locale == locale %} class="active"{% endif %}>
                        <a href="{{ url(app.request.get('_route'), app.request.get('_route_params') |merge({'_locale': locale })) }}" {% if app.request.locale == locale %}class="active"{% endif %}>
                            {{ file_get_public_contents('build/images/' ~ locale ~ '.svg') |raw }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </header>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="icon" type="image/png" href="{{ asset('build/images/favicon.png') }}" />
{% endblock %}

{% block content %}
<main>
    {% include 'partials/asideMenu.html.twig' %}
    {% block main_content %}{% endblock %}
</main>
{% endblock %}

{% block footer %}
    {% set backgrounds = [ 'bg_footer.jpg', 'bg_footer2.jpg', 'bg_footer3.jpg'] %}
    <footer class="idci-footer" style="background-image:url({{ asset('build/images/' ~ random(backgrounds)) }}); background-size: 100% 100%;">
        <section class="sup-footer">
            <article class="footer-part address">
                <h4 class="idci-light-blue">
                    IDCI-Consulting
                </h4>
                <p>109 rue Francis de Pressensé</p>
                <p>69100 Villeurbanne - FRANCE</p>
                <h5 style="color: #FFF">
                    {% trans %}Siège social{% endtrans %}
                </h5>
                <p>82 ruelle du Brief</p>
                <p>01170 Gex - FRANCE</p>
            </article>

            <article class="footer-part coords">
                <ul>
                    <li>
                        <a class="phonenumber" href="tel:0663231207"><i class="fas fa-tablet-alt"></i>06 63 23 12 07</a>
                    </li>
                    <li>
                        <a class="mail" href="mailto:contact@idci-consulting.fr"><i class="fas fa-envelope"></i>contact@idci-consulting.fr</a>
                    </li>
                </ul>
            </article>

            <article class="footer-part socials">
                <ul class="idci-inline-list">
                    <li>
                        <a href="https://twitter.com/idciconsulting" target="_blank" title="{%trans%}Follow us on{% endtrans %} Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com/IDCI-Consulting" target="_blank" title="{%trans%}Star us on{% endtrans %} Github">
                            <i class="fab fa-github"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.facebook.com/idciconsulting" target="_blank" title="{%trans%}Like us on{% endtrans %} Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    </li>
                    <li>
                        <a href="http://presentation.idci.fr" target="_blank" title="{%trans%}Presentation{% endtrans %}">
                            <i class="fas fa-play-circle"></i>
                        </a>
                    </li>
                </ul>
            </article>
        </section>
        <hr />
        <section class="sub-footer">
            <nav class="sub-links">
                <ul class="footer-menu">
                    <li class="idci-inline-list">
                       &#169; 2017 - idci v{{ version }}
                    </li>
                    <li class="idci-inline-list">
                        <a href="{{ url('website_legal_mentions') }}" class="mentions">{% trans %}Legal Mentions{% endtrans %}</a>
                    </li>
                    <li class="idci-inline-list">
                        <a href="{{ url('website_sitemap') }}" class="maps">{% trans %}Sitemap{% endtrans %}</a>
                    </li>
                </ul>
            </nav>
            {% if app.request.attributes.get("_route") != "website_contact" %}
                <a class="contact-us-link" id="contact-link" href="{{ url('website_contact') }}">{% trans %}Contact us{% endtrans %}</a>
            {% endif %}
        </section>
    </footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        document.querySelector('#contact-link').addEventListener("click", setUpModal);
        asideMenuHighlight();
    </script>
{% endblock %}