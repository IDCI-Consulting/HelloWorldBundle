{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css">
    <link href="{{ asset('css/' ~ getRevFilename('app.min.css') ~ '') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block header %}
    <div class="row full-width header-container">
        <header>
            <a class="hide-for-medium-up small-2 columns menu-icon">
                <i class="fa fa-bars"></i>
            </a>

            <h1 class="small-3 medium-1 large-2 columns logo">
                <a href="{{ path('index', {'_locale': app.translator.locale}) }}">
                    <img src="{{ asset('images/logo_idci.svg') }}"/>
                </a>
            </h1>

            <nav class="medium-7 large-6 columns nav-menu">
                {% block nav %}{% endblock %}
            </nav>

            <div class="hide-for-medium-down large-2 columns langs">
                <p class="choose-language">{% trans %}Choose the language{% endtrans %}</p>
                <ul class="hide-for-small-only idci-inline-list">
                    {% for locale, route in i18n_routes %}
                        <li{% if app.translator.locale == locale %} class="active"{% endif %}>
                            <a href="{{ route['route'] }}">
                                <img src="{{ asset('images/blank.gif') }}" class="flag flag-{{ locale }}" />
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="show-for-medium-down small-3 medium-1 medium-push-1 columns ">
                <button data-dropdown="drop-flags" aria-controls="drop1" class="dropdown dropdown-flag active"><img src="{{ asset('images/blank.gif') }}" class="flag flag-{{ app.translator.locale }}" /></button>
                <ul id="drop-flags" data-dropdown-content class="f-dropdown">
                    {% for locale, route in i18n_routes %}
                        <li{% if app.translator.locale == locale %} class="active"{% endif %}>
                            <a href="{{ route['route'] }}">
                                <img src="{{ asset('images/blank.gif') }}" class="flag flag-{{ locale }}" /> - {{ route['language']|trans }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="small-2 medium-1 columns search-icon">
                <a>
                    <i class="fa fa-search"></i>
                </a>
            </div>

            <form method="post"  class="hide-for-small-up form-search">
                <input type="search" placeholder="Recherche"/>
                <input type="submit" value="Valider" />
            </form>
        </header>
    </div>
{% endblock %}

{%  block content %}
<div class="container main-section">
    {% block main_content %}{% endblock %}
</div>
{% endblock %}

{% block footer %}
    <div class="hide-for-small-only idci-mini-footer">
        <a class="fa fa-envelope-o"></a>
    </div>

    <script type="text/javascript">
        $(document).ready(function() {
            $('.idci-mini-footer').on('click', function(e) {
                $('footer').css('display', 'block');
                $('.idci-mini-footer').attr("style", "display: none !important");
            });

            $(window).scroll(function() {
                if($(window).scrollTop() + $(window).height() >= $(document).height() - 1) {
                    $('footer').css('display', 'block');
                    $('.idci-mini-footer').attr("style", "display: none !important");
                }
            });
        });
    </script>

    <footer class="idci-footer">
        <a class="hide-for-small-only close-footer">&#215;</a>

        <script type="text/javascript">
            $(document).ready(function() {
                $('.close-footer').on('click', function(e) {
                    $('footer').css('display', 'none');
                    $('.idci-mini-footer').attr("style", "display: block !important");
                });
            });
        </script>

        <div class="row">
            <div class="medium-4 columns footer-part contact-us ">
                <p class="hide-for-small-only">
                    {% trans %}For any other request{% endtrans %}
                </p>
                <p class="hide-for-small-only">{% trans %}do not hesitate to{% endtrans %}</p>
                <p class="contact-us-link">
                    <a id="contact-link" href="{{ path('contact', {_locale: app.translator.locale}) }}" class="button small" data-reveal-id="idci-modal">{% trans %}Contact us{% endtrans %}</a>
                </p>
            </div>

            <div class="medium-4 columns footer-part address ">
                <h3 class="idci-light-blue">
                    {% trans %}Our contact details{% endtrans %}
                </h3>
                <p>256 rue Francis de Pressensé</p>
                <p>69100 Villeurbanne - FRANCE</p>
                <p>
                    <i class="fa fa-phone"></i>
                    <a href="tel:0663231207" class="phonenumber">06 63 23 12 07</a>
                </p>
                <p>
                    <i class="fa fa-envelope-o"></i>
                    <a href="mailto:contact@idci-consulting.fr" class="mail">contact@idci-consulting.fr</a>
                </p>
            </div>

            <div class="medium-4 columns footer-part footer-socials ">
                <h3 class="hide-for-small-only idci-light-blue">
                    {% trans %}Follow us{% endtrans %}
                </h3>
                <ul class="socials">
                    <li class="twitter">
                        <a href="https://twitter.com/idciconsulting" target="_blank"><span>Twitter</span></a>
                    </li>
                    <li class="rss">
                        <a href="#" target="_blank"><span>RSS</span></a>
                    </li>
                    <li class="github">
                        <a href="https://github.com/IDCI-Consulting" target="_blank"><span>Github</span></a>
                    </li>
                </ul>
            </div>
        </div>
    </footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $('#contact-link').on('click', function(event) {
                event.preventDefault();

                var request = $.ajax({
                    url: $(this).attr('href'),
                    method: "GET",
                    dataType: "html"
                });

                request.done(function(content) {
                    var $modal = $(
                        '<div id="idci-modal" class="reveal-modal" data-reveal aria-labelledby="contact" aria-hidden="true" role="dialog">' +
                            '<a class="close-reveal-modal" aria-label="Close">&#215;</a>' +
                        '</div>'
                    );
                    $modal.append(content);
                    $('footer').after($modal);
                    $modal.foundation('reveal', 'open');
                    focusFieldEffect();
                });

                request.fail(function(jqXHR, textStatus) {
                    console.log("Request failed: " + textStatus);
                });
            });
        });
    </script>
{% endblock %}