<p><em>Fort de nos 7 ans d'expériences,</em> nous proposons <em>plusieurs formations</em> allant du HTML5/CSS3 au développement d'applications complexes PHP avec le framework Symfony2.</p>

<span class="hide-for-small-only arrow"><img src="{{ asset('images/balise_left.svg') }}" /></span>
<h3 class="trainings">les différentes formations</h3>
<span class="hide-for-small-only arrow"><img src="{{ asset('images/balise_right.svg') }}" /></span>


<div class="courses">
    {% for course in app.config.courses %}
        <div>
            <a href="{{ path('courses', {'_locale': app.translator.locale}) }}"  class="tools-sprite {{ course }}">{{ course }}</a>
        </div>
    {% endfor %}
</div>

<script type="text/javascript">
    $(document).ready(function() {
        $('.courses').slick({
            infinite: true,
            nextArrow: '<img class="slick-arrow next right" src="{{ asset('images/slick_arrow.svg') }}"/>',
            prevArrow: '<img class="slick-arrow previous left" src="{{ asset('images/slick_arrow.svg') }}"/>',
            speed: 300,
            autoplay: true,
            autoplaySpeed: 2000,
            fade: true,
            cssEase: 'linear'
        });
    });
</script>
