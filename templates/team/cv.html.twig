{% extends "layout.html.twig" %}
{% trans_default_domain 'team' %}

{% block nav %}
    {% include 'menu.html.twig' with {
    'menu': menu,
    'active': 'website_team'
    } %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('cv_theme_' ~ theme) }}
{% endblock %}

{% block main_content %}
    {% include 'team/_cv.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('h2').forEach(function(h2) {
            h2.id = slugify(h2.innerHTML);
        })
        document.querySelectorAll('h3').forEach(function(h3) {
            h3.id = slugify(h3.innerHTML);
        })
        makeSyntaxHighlighting();
    </script>
{% endblock %}
