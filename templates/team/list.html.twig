{% extends 'layout.html.twig' %}

{% block title %}Notre équipe{% endblock %}

{% block main %}

<section class="section-container section-container-90">
    <section class="section-members">
        <p class="section-members-title idci-subtitle-primary">{% trans from "members" %}members.title{% endtrans %}</p>
        <p class="section-members-introduction">{% trans from "members" %}members.introduction{% endtrans %}</p>
