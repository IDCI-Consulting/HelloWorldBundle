            <div class="section-member-card">
                <p class="section-member-card-title idci-title-primary">Gabriel Bondaz</p>
                <p class="section-member-card-subtitle idci-subtitle-secondary">{% trans from "members" %}gabriel.subtitle{% endtrans %}</p>
                <img src="{{ asset('build/images/members/gabriel-sprite.png') }}" alt="{% trans from "alt" %}gabriel-sprite{% endtrans %}" class="section-member-card-media">
                <p class="section-member-card-description">{% trans from "members" %}gabriel.description{% endtrans %}</p>
                <a href="{{ url('app_team_member', {'slug' : 'gabriel_bondaz'}) }}" class="button section-member-card-button">{% trans from "members" %}members.check_cv{% endtrans %}</a>
            </div>

