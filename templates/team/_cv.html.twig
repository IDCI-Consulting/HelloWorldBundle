{% trans_default_domain 'team' %}

<section class="curriculum-vitae {% if app.request.attributes.get("_route") == "website_cvpdf" %}pdf{% endif %}">
    {% if app.request.attributes.get("_route") == "website_cv" %}
        <a href="{{ url('website_cvpdf', {'name': name, 'theme': 'idci', 'anonymous': false}) }}" class="idci-button small-screen">{% trans %}button.team.download{% endtrans %}</a>
        <a href="{{ url('website_cvpdf', {'name': name, 'theme': 'idci', 'anonymous': true }) }}" class="idci-button small-screen">{% trans %}button.team.anonymous{% endtrans %}</a>
    {% endif %}
    <header class="cv-part cv-header">
        <h3 class="title">Curriculum vitae</h3>
        {% if anonymous is defined and anonymous == true %}
        {% else %}
            <h4 class="name">{{ data.basics.name }}
                |
                {{ data.basics.label }}</h4>
            {% if app.request.attributes.get("_route") == "website_cv" %}
                <ul class="socials">
                    {% for profil in data.basics.profiles %}
                        <li>
                            <a href="{{ profil.url }}" class="social-links">{{ file_get_public_contents('build/images/' ~ profil.network ~'-icon.svg') |raw }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endif %}
    </header>
    {% if anonymous is defined and anonymous == true %}
    {% else %}
        <article class="cv-part about-me">
            <h3>{% trans %}title.cv.aboutMe{% endtrans %}</h3>
            <ul>
                <li>{% trans %}label.cv.age{% endtrans %}<strong>{{ get_age(data.basics.birthDate) }}</strong>
                </li>
                <li>{% trans %}label.cv.email{% endtrans %}<strong>{{ data.basics.email }}</strong>
                </li>
                <li>{% trans %}label.cv.phone{% endtrans %}<strong>{{ data.basics.phone }}</strong>
                </li>
                <li>
                    {% trans %}label.cv.languages{% endtrans %}
                    <ul class="languages-cv">
                        {% for language in data.languages %}
                            <li>
                                <strong>
                                    {{ language.language }}:
                                    {{ language.fluency }}{% if not loop.last %},
                                    {% endif %}
                                </strong>
                            </li>
                        {% endfor %}
                    </ul>
                </li>
            </ul>
        </article>
    {% endif %}
    <article class="cv-part professional-experience">
        <h3>{% trans %}title.cv.professionalExperiences{% endtrans %}</h3>
        {% set date_stamp = 0 %}
        {% for experience in data.work %}
            {% if date_stamp != experience.startDate %}
                {% set date_stamp = experience.startDate %}
                <i>{{ experience.startDate }}</i>
            {% endif %}
            <p>{{ experience.summary }}</p>
            {% if experience.highlights|length > 0 %}
                <ul class="highlights">
                    {% for highlight in experience.highlights %}
                        <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}
    </article>
    <article class="cv-part volunteer">
        <h3>{% trans %}title.cv.personalProjects{% endtrans %}</h3>
        {% set date_stamp = 0 %}
        {% for task in data.volunteer %}
            {% if date_stamp != task.startDate %}
                {% set date_stamp = task.startDate %}
                <i>{{ task.startDate }}</i>
            {% endif %}
            <p>{{ task.summary }}</p>
            {% if task.highlights|length > 0 %}
                <ul class="highlights">
                    {% for highlight in task.highlights %}
                        <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}
    </article>
    <article class="cv-part education">
        <h3>{% trans %}title.cv.education{% endtrans %}</h3>
        {% set date_stamp = 0 %}
        {% for study in data.education %}
            {% if date_stamp != study.endDate %}
                {% set date_stamp = study.endDate %}
                <i>{{ study.endDate }}</i>
            {% endif %}
            <p>{{ study.studyType }}
                {{ 'in'|trans }}
                {{ study.area }}
                {{ 'at'|trans }}
                {{ study.institution }}</p>
        {% endfor %}
    </article>
    <article class="cv-part skills">
        <h3>{% trans %}title.cv.skills{% endtrans %}</h3>
        <ul class="skills-list">
            {% for skill in data.skills %}
                <li {% if skill.keywords |length > 7 %}class="too-many-skills"{% endif %}>
                    <strong>{{ skill.name }}</strong>
                    <p>
                        {% for tool in skill.keywords %}
                            {{ tool }}{% if not loop.last %},{% endif %}
                        {% endfor %}
                    </p>
                </li>
            {% endfor %}
        </ul>
    </article>
    {% if app.request.attributes.get("_route") == "website_cv" %}
        <a href="{{ url('website_cvpdf', {'name': name, 'theme': 'idci', 'anonymous': false }) }}" class="idci-button large-screen">{% trans %}button.team.download{% endtrans %}</a>
        <a href="{{ url('website_cvpdf', {'name': name, 'theme': 'idci', 'anonymous': true }) }}" class="idci-button large-screen">{% trans %}button.team.anonymous{% endtrans %}</a>
    {% endif %}
</section>
