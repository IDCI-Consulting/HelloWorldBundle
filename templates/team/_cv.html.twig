{% trans_default_domain 'cv' %}

<section class="section-container">
    <section class="section-cv">
        <section class="columns is-multiline is-centered section-cv-header">
            <h1 class="column is-12 section-cv-title idci-title-secondary">{{ 'cv.title'|trans }}</h1>
            <p class="column is-6 section-cv-label">{{ data.identity.firstName }} {{ data.identity.lastName }} | {{ data.identity.job[app.request.locale] }}</p>
            {% if data.identity.socialNetworks is defined and data.identity.socialNetworks is not empty and data.identity.socialNetworks is not null %}
                <p class="column is-6 section-cv-links">
                    {% for socialNetwork in data.identity.socialNetworks %}
                        <a href="{{ socialNetwork.url }}"><i class="fab fa-{{ socialNetwork.name }} fa-3x"></i></a>
                    {% endfor %}
                </p>
            {% endif %}
        </section>

        <section class="section-cv-banner section-cv-banner-primary">
            <h2 class="section-cv-banner-title idci-title-secondary">{{ 'cv.about_me'|trans }}</h2>
            <table class="section-cv-banner-table">
                <tbody>
                    <tr>
                        <th scope="row">{{ 'cv.age'|trans }}</td>
                        <td>{{ 'now'|date("Y") - data.identity.birthDate|date("Y") }} {{ 'cv.years_old'|trans }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'cv.email'|trans }}</th>
                        <td>{{ data.identity.email }}</td>
                    </tr>
                    {% if data.identity.phone is defined and data.identity.phone is not null and data.identity.phone is not empty %}
                        <tr>
                            <th scope="row">{{ 'cv.phone'|trans }}</th>
                            <td>{{ data.identity.phone }}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </section>

        <section class="section-cv-banner section-cv-banner-secondary">
            <h2 class="section-cv-banner-title idci-title-secondary">{{ 'cv.professional_experiences'|trans }}</h2>
            {% for professionalExperience in data.professionalExperiences %}
                <p class="section-cv-banner-subtitle">
                    {% if "" == professionalExperience.endDate %}
                        {{ 'cv.since'|trans }} {{ professionalExperience.startDate|format_datetime(pattern='MMMM Y', locale=app.request.locale) }}
                    {% else %}
                        {{ 'cv.from'|trans }} {{ professionalExperience.startDate|format_datetime(pattern='MMMM Y', locale=app.request.locale) }} {{ 'cv.to'|trans }} {{ professionalExperience.endDate|format_datetime(pattern='MMMM Y', locale=app.request.locale) }}
                    {% endif %}
                    {% if professionalExperience.company is defined and professionalExperience.company is not empty and professionalExperience.company is not null %}
                        {{ 'cv.at'|trans }} {{ professionalExperience.company }}
                    {% endif %}
                </p>
                <p>{{ professionalExperience.role[app.request.locale] }}</p>
                {% if professionalExperience.tasks[app.request.locale]|length > 0 %}
                    <ul class="section-cv-banner-highlights">
                        {% for task in professionalExperience.tasks[app.request.locale] %}
                            <li class="section-cv-banner-highlights-element">{{ task|raw }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </section>

        {% if data.education is defined and data.education is not null and data.education is not empty %}
            <section class="section-cv-banner section-cv-banner-primary">
                <h2 class="section-cv-banner-title idci-title-secondary">{{ 'cv.courses'|trans }}</h2>
                {% for education in data.education %}
                    <p><span class="section-cv-banner-education-date">{{ education.endDate|date("Y") }}</span>{{ education.certificate }}</p>
                {% endfor %}
            </section>
        {% endif %}

        <section class="section-cv-banner section-cv-banner-secondary">
            <h2 class="section-cv-banner-title idci-title-secondary">{{ 'cv.skills'|trans }}</h2>
            {% for expertise in data.expertises %}
                <p class="section-cv-banner-subtitle section-cv-banner-skills-title">{{ expertise.name[app.request.locale] }}</p>
                <ul class="section-cv-banner-skills">
                    {% for skill in expertise.skills %}
                    <li>
                        <p class="section-cv-banner-skill-title">{{ skill.name[app.request.locale] }}</p>
                        <p class="section-cv-banner-skill-details">
                            {% if skill.keywords is defined %}
                                {% for keyword in skill.keywords %}
                                    {{ keyword }}{% if loop.last != true %}, {% endif %}
                                {% endfor %}
                            {% else %}
                                {{ skill.level[app.request.locale] }}
                            {% endif %}
                        </p>
                    </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </section>

        {% if data.personalExperiences is defined and data.personalExperiences is not null and data.personalExperiences is not empty %}
            <section class="section-cv-banner section-cv-banner-primary">
                <h2 class="section-cv-banner-title idci-title-secondary">{{ 'cv.personal_experiences'|trans }}</h2>
                {% for personalExperience in data.personalExperiences %}
                    <p class="section-cv-banner-subtitle">
                    {% if "" == personalExperience.endDate %}
                        {{ 'cv.since'|trans }} {{ personalExperience.startDate|format_datetime(pattern='MMMM Y', locale=app.request.locale) }}
                    {% else %}
                        {{ 'cv.from'|trans }} {{ personalExperience.startDate|format_datetime(pattern='MMMM Y', locale=app.request.locale) }} {{ 'cv.to'|trans }} {{ personalExperience.endDate|format_datetime(pattern='MMMM Y', locale=app.request.locale) }}
                    {% endif %}
                    </p>
                    <p>{{ personalExperience.role[app.request.locale] }} | {{ personalExperience.organization[app.request.locale] }}</p>
                    <p>{{ personalExperience.description[app.request.locale] }}</p>
                {% endfor %}
            </section>
        {% endif %}

        {% if data.hobbies is defined and data.hobbies is not null and data.hobbies is not empty %}
            <section class="section-cv-banner section-cv-banner-secondary">
                <h2 class="section-cv-banner-title idci-title-secondary">{{ 'cv.hobbies'|trans }}</h2>
                {% for hobby in data.hobbies[app.request.locale] %}
                    <p class="section-cv-banner-subtitle">{{ hobby.name }}</p>
                    <p>{{ hobby.description }}</p>
                {% endfor %}
            </section>
        {% endif %}
    </section>
</section>