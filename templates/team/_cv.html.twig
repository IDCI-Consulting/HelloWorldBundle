<section class="section-container">
    <section class="section-cv">
        <section class="columns is-multiline is-centered">
            <p class="column is-12 section-cv-title idci-title-secondary">Curriculum Vitae</p>
            <p class="column is-6 section-cv-label">{{ data.basics.name }} | {{ data.basics.label }}</p>
            <p class="column is-6 section-cv-links">
                <a href="https://github.com/konandrum"><i class="fab fa-github fa-3x"></i></a>
                <a href="https://linkedin.com/in/gabriel-bondaz"><i class="fab fa-linkedin fa-3x"></i></a>
            </p>
        </section>

        <section class="section-cv-banner section-cv-banner-primary">
            <p class="section-cv-banner-title idci-title-secondary">A propos de moi</p>
            <ul class="section-cv-banner-list">
                <li class="section-cv-banner-list-item">Âge<p></p></li>
                <li class="section-cv-banner-list-item">Email<p>{{ data.basics.email }}</p></li>
                <li class="section-cv-banner-list-item">Tél<p>{{ data.basics.phone }}</p></li>
                <li class="section-cv-banner-list-item">Langues<p></p></li>
            </ul>
        </section>

        <section class="section-cv-banner section-cv-banner-secondary">
            <p class="section-cv-banner-title idci-title-secondary">Expériences professionnelles</p>
            {% set date_stamp = 0 %}
            {% for work in data.work %}
                {% if date_stamp != work.startDate %}
                    {% set date_stamp = work.startDate %}
                    <p class="section-cv-banner-subtitle">Depuis {{ work.startDate }}</p>
                {% endif %}
                <p>{{ work.summary }}</p>
                {% if work.highlights|length > 0 %}
                    <ul class="section-cv-banner-highlights">
                        {% for highlight in work.highlights %}
                            {{ highlight }}
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </section>

        <section class="section-cv-banner section-cv-banner-primary">
            <p class="section-cv-banner-title idci-title-secondary">Formations</p>
            {% for education in data.education %}
                <p><span class="section-cv-banner-education-date">{{ education.endDate }}</span>{{ education.studyType }}</p>
            {% endfor %}
        </section>

        <section class="section-cv-banner section-cv-banner-secondary">
            <p class="section-cv-banner-title idci-title-secondary">Outils informatiques</p>
            {% for skill in data.skills %}
            <ul class="section-cv-banner-skills">
                <li>
                    <p class="section-cv-banner-skill-title">{{ skill.name }}</p>
                    <p class="section-cv-banner-skill-keywords">
                        {% for keyword in skill.keywords %}
                            {{ keyword }}, 
                        {% endfor %}
                    </p>
                </li>
            </ul>
            {% endfor %}
        </section>

        <section class="section-cv-banner section-cv-banner-primary">
            <p class="section-cv-banner-title idci-title-secondary">Expériences personnelles</p>
            {% set date_stamp = 0 %}
            {% for task in data.volunteer %}
                {% if date_stamp != task.startDate %}
                    {% set date_stamp = task.startDate %}
                    <p class="section-cv-banner-subtitle">Depuis {{ task.startDate }}</p>
                {% endif %}
                <p>{{ task.summary }}</p>
                {% if task.highlights|length > 0 %}
                    <ul class="section-cv-banner-highlights">
                        {% for highlight in task.highlights %}
                            <li>{{ highlight }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </section>    
    </section>
</section>