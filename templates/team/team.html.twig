        <h2 class="name">Gabriel Bondaz</h2>
        <em class="job-position">{% trans %}Manager{% endtrans %}</em>
        <img src="{{ asset('build/images/sprite_gabriel.png') }}" class="profile-picture front" />
        <p class="member-description">{% trans %}text.gabriel{% endtrans %}</p>
        <a href="{{ url('website_vcard', {'name': 'gabriel_bondaz'}) }}" class="see-vcard">{% trans %}See cv{% endtrans %}</a>
    </article>
    <article class="member frederic">
        <h2 class="name">Frédéric Bondaz</h2>
        <em class="job-position">{% trans %}Manager{% endtrans %}</em>
        <img src="{{ asset('build/images/sprite_frederic.png') }}" />
        <p class="member-description">{% trans %}text.frederic{% endtrans %}</p>
        <a href="{{ url('website_vcard', {'name': 'frederic_bondaz'}) }}" class="see-vcard">{% trans %}See cv{% endtrans %}</a>
    </article>
    <article class="member baptiste">
        <h2 class="name">Baptiste Bouchereau</h2>
        <em class="job-position">{% trans %}Manager{% endtrans %}</em>
        <img src="{{ asset('build/images/sprite_baptiste.png') }}" class="profile-picture up" />
        <p class="member-description">{% trans %}text.baptiste{% endtrans %}</p>
        <a href="{{ url('website_vcard', {'name': 'baptiste_bouchereau'}) }}" class="see-vcard">{% trans %}See cv{% endtrans %}</a>
