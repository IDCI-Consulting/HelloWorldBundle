{% extends "layout.html.twig" %}
{% trans_default_domain 'team' %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'website_team'
    } %}
{% endblock %}

{% block main_content %}

<header class="title"><h1>{% trans %}The team{% endtrans %}</h1></header>

<section class="team">
    <article class="member gabriel">
        <h2 class="name">Gabriel Bondaz</h2>
        <em class="job-position">{% trans %}Manager{% endtrans %}</em>
        <img src="{{ asset('build/images/sprite_gabriel.png') }}" class="profile-picture front" />
        <p class="member-description">{% trans %}text.gabriel{% endtrans %}</p>
        <a href="{{ url('website_cv', {'name': 'gabriel_bondaz', 'theme': 'idci'}) }}" class="idci-button see-cv">{% trans %}button.team.seeCv{% endtrans %}</a>
    </article>
    <article class="member frederic">
        <h2 class="name">Frédéric Bondaz</h2>
        <em class="job-position">{% trans %}Manager{% endtrans %}</em>
        <img src="{{ asset('build/images/sprite_frederic.png') }}" />
        <p class="member-description">{% trans %}text.frederic{% endtrans %}</p>
        <a href="{{ url('website_cv', {'name': 'frederic_bondaz', 'theme': 'idci'}) }}" class="idci-button see-cv">{% trans %}button.team.seeCv{% endtrans %}</a>
    </article>
    <article class="member brahim">
        <h2 class="name">Brahim Boukoufallah</h2>
        <em class="job-position">{% trans %}Manager{% endtrans %}</em>
        <img src="{{ asset('build/images/sprite_brahim.png') }}" class="profile-picture down" />
        <p class="member-description">{% trans %}text.brahim{% endtrans %}</p>
        <a href="{{ url('website_cv', {'name': 'brahim_boukoufallah', 'theme': 'idci'}) }}" class="idci-button see-cv">{% trans %}button.team.seeCv{% endtrans %}</a>
    </article>
</section>

{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        handleHeadFollowing();
    </script>
{% endblock %}