<div id="flash-message-container">
    {% for label, flashes in app.session.flashbag.all %}
        {% for flash in flashes %}
            <div data-alert class="alert-box {{ label }} radius">
                {{ flash|trans }}
                <a href="#" class="close">&times;</a>
            </div>
        {% endfor %}
    {% endfor %}
</div>