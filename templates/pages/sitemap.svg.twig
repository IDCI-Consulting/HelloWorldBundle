{% extends 'layout.html.twig' %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu
    } %}
{% endblock %}

{% block main_content %}
    <div class="row sitemap">
        <h1 class="small-12 columns">{% trans %}Sitemap{% endtrans %}</h1>
        <svg class="small-12 columns sitemap" viewBox="0 0 1500 1500">
            {% for url in urls %}
                {% if loop.index % 2 == 0 %}
                    <circle r="{{ url.priority * 50 }}px" transform="translate(100, {{ loop.index * 60 }})" />
                    <a xlink:href="{{ url.loc }}">
                        <text x="160" y="{{ loop.index * 60 }}">
                            {{ url.loc }}
                        </text>
                    </a>
                {% else %}
                    <circle r="{{ url.priority * 50 }}px" transform="translate(950, {{ loop.index * 60 }})" />
                    <a xlink:href="{{ url.loc }}">
                        <text x="1010" y="{{ loop.index * 60 }}">
                            {{ url.loc }}
                        </text>
                    </a>
                {% endif %}
            {% endfor %}
        </svg>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $(document).ready(function() {
            var $svg = $('svg.sitemap');

            var urlsLenght = {{ urls|length }};

            $svg.height(urlsLenght * 45);
            if ($(window).width() < 800) {
                $svg.height(urlsLenght * 20);
            }
        });
    </script>
{% endblock %}