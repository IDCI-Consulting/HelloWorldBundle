{% extends "layout.html.twig" %}

{% block metaTags %}
<meta name="description" content="Nous rédigeons des articles à la manière de tutoriels, principalement sur le framework Symfony2">
{% endblock %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'blog'
    } %}
{% endblock %}

{% block main_content %}
    <section class="full-width blog">
        <div class="row">
            <h1 class="small-12 columns title">Blog</h1>
        </div>
        {% include 'partials/asideMenu.html.twig' %}
        {% include 'partials/blog/lastArticles.html.twig' %}
        {% include 'partials/blog/allArticles.html.twig' %}

    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $(document).ready(function() {
            $('.articles').slick({
                inifinite: true,
                nextArrow: '<img class="slick-arrow next right" src="{{ asset('images/slick_arrow.svg') }}"/>',
                prevArrow: false,
                autoplay: true,
                autoplaySpeed: 10000
            });
        });
    </script>
{% endblock %}
