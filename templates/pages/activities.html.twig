{% extends "layout.html.twig" %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
        'menu': menu,
        'active': 'activities'
    } %}
{% endblock %}

{% block main_content %}
    {% include 'partials/activities/projects.html.twig' %}
{% endblock %}


{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $(document).ready(function() {
            $('.projects-content').slick({
                autoplay: true,
                autoplaySpeed: 15000,
                inifinite: true,
                nextArrow: '<img class="slick-arrow next right" src="{{ asset('images/slick_arrow.svg') }}"/>',
                prevArrow: false
            });
        });
    </script>
{% endblock %}