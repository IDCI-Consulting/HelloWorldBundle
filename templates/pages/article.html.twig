{% extends "layout.html.twig" %}

{% block metaTags %}
    {% for meta in articleConfiguration %}
        <meta {{ meta.attributeName }}="{{ meta.attributeValue }}" content="{{ meta.content }}" />
    {% endfor %}
{% endblock %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'blog'
    } %}
{% endblock %}

{% block main_content %}
    <div class="row">
        <div class="small-12 columns blog-article">
            {{ article|raw }}
        </div>
    </div>
    <div class="row">
        <div id="disqus_thread" class="small-12 columns"></div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}

<script src="{{ asset('js/idciScripts/articleNavBuilder.js') }}"></script>
<script src="{{ asset('js/idciScripts/scrollTo.js') }}"></script>
<script>
    $(document).ready(function () {
      buildNavMenu();
    });
    var hashCode = function(string) {
        var hash = 0, i, chr, len;
        if (string.length === 0) return hash;
        for (i = 0, len = string.length; i < len; i++) {
            chr   = string.charCodeAt(i);
            hash  = ((hash << 5) - hash) + chr;
            hash |= 0; // Convert to 32bit integer
        }
        return hash;
    };

     var disqus_config = function () {
         this.page.url = "{{ app.request_stack.getCurrentRequest().getSchemeAndHttpHost() }}{{ app.request_stack.getCurrentRequest().getRequestUri() }}"; // Replace PAGE_URL with your page's canonical URL variable
         this.page.identifier = hashCode("{{ app.request_stack.getCurrentRequest().getRequestUri() }}"); // Replace PAGE_IDENTIFIER with your page's unique identifier variable
         this.language = "{{ app.translator.locale }}";
     };

    (function() { // DON'T EDIT BELOW THIS LINE
        var d = document, s = d.createElement('script');

        s.src = '//idci.disqus.com/embed.js';

        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>
{% endblock %}
