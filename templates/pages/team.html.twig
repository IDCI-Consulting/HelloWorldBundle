{% extends "layout.html.twig" %}

{% block devJavascripts %}
<script src="{{ asset('js/headMouseTracker/HeadImage.js') }}"></script>
<script src="{{ asset('js/headMouseTracker/getMousePosition.js') }}"></script>
<script src="{{ asset('js/headMouseTracker/initImages.js') }}"></script>
{% endblock %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'team'
    } %}
{% endblock %}

{% block main_content %}
<section class="row team">
    <header class="small-12 columns">
        <h2 class="title">
            <i class="show-for-small-only fa fa-user"></i>
            {% trans %}The team{% endtrans %}
        </h2>
    </header>

    {%
        include 'partials/team/gabriel.html.twig'
            with {
                'firstName': 'gabriel',
            }
    %}

    {%
        include 'partials/team/frederic.html.twig'
            with {
                'firstName': 'frederic',
            }
    %}

    {%
        include 'partials/team/baptiste.html.twig'
            with {
                'firstName': 'baptiste',
            }
    %}

    {%
        include 'partials/team/brahim.html.twig'
        with {
            'firstName': 'brahim',
        }
    %}
</section>
{% endblock %}
