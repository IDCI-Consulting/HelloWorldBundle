{% extends "layout.html.twig" %}

{% block devJavascripts %}
<script src="{{ asset('js/headMouseTracker/HeadImage.js') }}"></script>
<script src="{{ asset('js/headMouseTracker/getMousePosition.js') }}"></script>
<script src="{{ asset('js/headMouseTracker/initImages.js') }}"></script>
{% endblock %}

{% block main_content %}
<article class="team row">
    <header>
        <h1 class="title team">
            <i class="show-for-small fa fa-user"></i>
            {% trans %}The team{% endtrans %}
        </h1>
    </header>

    {%
        include 'partials/team/brahim.html.twig'
        with {
            'firstName': 'brahim',
            'skills': [
                'Symfony, Silex, MeteorJS, NodeJS',
                'AngularJS, jQuery, CSS, HTML',
                'Nginx, Apache, Docker',
                'Sql, NoSql'
            ]
        }
    %}

    {%
    include 'partials/team/gabriel.html.twig'
        with {
            'firstName': 'gabriel',
            'skills': [
                'test',
                'test2',
                'test3'
            ],
        }
    %}
</article>
{% endblock %}