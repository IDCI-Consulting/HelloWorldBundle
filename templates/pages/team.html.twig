{% extends "layout.html" %}

{% block devJavascripts %}
    <script src="{{ asset('js/headMouseTracker/HeadImage.js') }}"></script>
    <script src="{{ asset('js/headMouseTracker/getMousePosition.js') }}"></script>
    <script src="{{ asset('js/headMouseTracker/initImages.js') }}"></script>
{% endblock %}

{% block content %}
    <h1 class="team capitalize">
        <i class="show-for-small fa fa-user"></i>
        Team
    </h1>

    <div class="content-wrapper hide-for-small">
        <div class="image-holder brahim">
            <img class="circle" src="{{ asset('images/circle.png') }}"/>
            <div class="profile-picture front"></div>
        </div>
    </div>


    <div class="show-for-small text-left team-content">
        {%
            include 'partials/teamMember.html.twig'
            with {
                'firstName': 'brahim',
                'lastName': 'boukoufallah',
                'profession': 'analyste developpeur',
                'skills': [
                    'test'
                ]
            }
        %}
    </div>
    {%  include 'partials/footer.html.twig' %}
{% endblock %}