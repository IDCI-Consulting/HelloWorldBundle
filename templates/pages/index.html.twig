{% extends "layout.html.twig" %}

{% block main_content %}
<section class="experiences">
    <div class="row">
        {% include 'partials/index/training.html.twig' %}
        {% include 'partials/index/advice.html.twig' %}
        {% include 'partials/index/development.html.twig' %}
    </div>
</section>

<section class="philosophies idci-blue hide-for-small-only">
    <div class="row">
        {% include 'partials/index/philosophy.html.twig' %}
        {% include 'partials/index/approach.html.twig' %}
    </div>
</section>

<section class="tools hide-for-small-only">
    <div class="row">
        <header class="small-12 columns">
            <h2 class="title">{% trans %}Our tools{% endtrans %}</h2>
        </header>
        {%
            include 'partials/index/tools.html.twig'
            with {
                'class': 'backend',
                'title': 'Backend',
                'images': ['symfony1', 'symfony2', 'node', 'meteor']
            }
        %}
        {%
            include 'partials/index/tools.html.twig'
            with {
                'class': 'databases',
                'title': 'Databases',
                'images': ['mysql', 'mongodb', 'postgresql', 'redis']
            }
        %}
        {%
            include 'partials/index/tools.html.twig'
            with {
                'class': 'frontend',
                'title': 'Frontend',
                'images': ['html5-css3', 'bootstrap', 'foundation', 'jquery']
            }
        %}
        {%
            include 'partials/index/tools.html.twig'
            with {
                'class': 'infrastructure',
                'title': 'Infrastructure',
                'images': ['elk', 'varnish', 'docker', 'proxmox']
            }
        %}
    </div>
</section>
{% endblock %}