{% extends "layout.html.twig" %}

{% block idci_logo %}
    <h1 class="small-7 large-1 columns logo">
        <a href="{{ path('index', {'_locale': app.translator.locale}) }}">
            <img src="{{ asset('images/logo_idci.svg') }}" alt="idci-logo" title="IDCI Consulting"/>
        </a>
    </h1>
{% endblock  %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'index'
    } %}
{% endblock %}

{% block main_content %}
    {% include 'partials/asideMenu.html.twig' %}
    {% include 'partials/index/presentation.html.twig' %}
    {% include 'partials/index/advice.html.twig' %}
    {% include 'partials/index/training.html.twig' %}
    {% include 'partials/index/development.html.twig' %}

    <div class="hide-for-small-only">
        {% include 'partials/index/philosophy.html.twig' %}
        {% include 'partials/index/approach.html.twig' %}

        <section id="{% trans %}tools{% endtrans %}" class="tools full-width">
            <div class="row">
                <header>
                    <h2>
                        {% trans %}Our tools{% endtrans %}
                    </h2>
                    <img class="tools-icon" src="{{ asset('images/icon_outils.svg') }}" alt="{% trans %}tools icon{% endtrans %}"/>
                </header>
                <div class="medium-2 columns">
                    {%
                        include 'partials/index/tools.html.twig'
                        with {
                            'class': 'backend',
                            'title': 'Backend',
                            'images': {
                                'php': 'https://secure.php.net/',
                                'symfony1': 'http://symfony.com/legacy',
                                'symfony2': 'http://symfony.com/',
                                'node': 'https://nodejs.org/',
                                'meteor': 'https://www.meteor.com/'
                            }
                        }
                    %}
                </div>

                <div class="medium-2 columns">
                    {%
                        include 'partials/index/tools.html.twig'
                        with {
                            'class': 'databases',
                            'title': 'Databases',
                            'images': {
                                'mysql': 'https://www.mysql.fr/',
                                'mongodb': 'https://www.mongodb.org/',
                                'postgresql': 'http://www.postgresql.org/',
                                'redis': 'http://redis.io/'
                            }
                        }
                    %}
                </div>

                <div class="medium-3 columns">
                    {%
                    include 'partials/index/tools.html.twig'
                    with {
                        'class': 'infrastructure',
                        'title': 'Infrastructure',
                        'images': {
                            'varnish': 'https://www.varnish-cache.org/',
                            'proxmox': 'https://www.proxmox.com/en/',
                            'ansible': 'http://www.ansible.com/home',
                            'elk': 'https://www.elastic.co/fr/products',
                            'docker': 'https://www.docker.com/',
                            'rabbitmq': 'https://www.rabbitmq.com/'
                        }
                    }
                    %}
                </div>

                <div class="medium-2 columns">
                    {%
                        include 'partials/index/tools.html.twig'
                        with {
                            'class': 'frontend',
                            'title': 'Frontend',
                            'images': {
                                'html5-css3': 'http://www.w3.org/TR/html5/',
                                'bootstrap': 'http://getbootstrap.com/',
                                'foundation': 'http://foundation.zurb.com/',
                                'angular': 'https://angularjs.org/',
                                'sass': 'http://sass-lang.com/',
                            }
                        }
                    %}
                </div>

                <div class="medium-3 columns">
                    {%
                    include 'partials/index/tools.html.twig'
                    with {
                        'class': 'qualite',
                        'title': 'Quality',
                        'images': {
                            'php-unit': 'https://phpunit.de/',
                            'gitlab': 'https://about.gitlab.com/',
                            'redmine': 'http://www.redmine.org/projects/redmine/wiki',
                        }
                    }
                    %}
                </div>
            </div>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        var timer;

        var showText = function (editor, snippet, index) {
            if (index < snippet.length) {
                // insert at cursor
                editor.getSession().insert(editor.getCursorPosition(), snippet[index++]);

                // clear selection just in case there was something selected
                editor.selection.clearSelection();

                // make sure cursor is visible
                editor.renderer.scrollCursorIntoView();

                timer = setTimeout(function () {
                    showText(editor, snippet, index);
                }, 50);
            }
        };

        var getFileRaw = function (editor) {
            // Clear the timeout callback
            clearTimeout(timer);

            // Clear the editor
            editor.setValue("");

            var idciCodeWriter = {{ idci_code_writer|raw }};

            // get a random file object
            var file = idciCodeWriter.files[Math.floor(Math.random() * idciCodeWriter.files.length)];

            $.ajax({
                url: file.url,
                method: "GET",
                success: function (fileRaw) {
                    // Github api provides the fileraw's content encoded in base64 format. We need to use atob() function to decode it.
                    var content = fileRaw;

                    editor.getSession().setMode("ace/mode/" + file.language);
                    editor.setTheme("ace/theme/" + file.theme);
                    showText(editor, content, 0);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    showText(editor, '//{% trans %}Write your code here{% endtrans %}!!!')
                }
            });
        };

        $(document).ready(function () {
            var editor = ace.edit("editor");

            // Disable warn message in console. Advised by Ace developers.
            editor.$blockScrolling = Infinity;

            var options = {
                animatedScroll: true,
                autoScrollEditorIntoView: true,
                fontSize: 10,
                mode: "ace/mode/php",
                scrollSpeed: 1,
                showFoldWidgets: false,
                showPrintMargin: false,
                theme: "ace/theme/dreamweaver"
            };

            editor.setOptions(options);

            getFileRaw(editor);

            // Call getFIleRaw every 2 minutes
            setInterval(function () {
                getFileRaw(editor);
            }, 120000);
        });
    </script>
{% endblock %}
