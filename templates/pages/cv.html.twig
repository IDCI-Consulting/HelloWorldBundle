{% extends 'layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}

    {% include 'partials/cv/stylesheet.html.twig' with {"theme": theme} %}
{% endblock %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'team'
    } %}
{% endblock %}

{% block main_content %}
    <div class="row full-width cv">
        <div class="small-12 columns">
            {{ html_cv|raw }}
        </div>
        <div class="small-12 columns">
            <a class="button small export-cv" href="{{ path('cv', {'_locale': app.translator.locale, 'theme': 'idci', 'name': name, '_format': 'pdf'}) }}">{% trans %}Download{% endtrans %}</a>
        </div>
    </div>
{% endblock %}