{% extends 'layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}

    <link href="{{ asset('css/cv/theme/' ~ theme ~ '.min.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'team'
    } %}
{% endblock %}

{% block main_content %}
    <div class="row full-width cv">
        <div class="small-12 show-for-small-only columns download-cv">
            <a class="button small export-cv" href="{{ path('cv', {'_locale': app.translator.locale, 'theme': 'idci', 'name': name, '_format': 'pdf'}) }}">{% trans %}Download{% endtrans %}</a>
        </div>
        <div class="small-12 columns html">
            {{ html_cv|raw }}
        </div>
        <div class="small-12 hide-for-small-only columns download-cv">
            <a class="button small export-cv" href="{{ path('cv', {'_locale': app.translator.locale, 'theme': 'idci', 'name': name, '_format': 'pdf'}) }}">{% trans %}Download{% endtrans %}</a>
        </div>
    </div>
{% endblock %}