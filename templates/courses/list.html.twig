{% extends 'layout.html.twig' %}

{% block title %}Présentation de nos formations{% endblock %}

{% block main %}
    {% set locale = app.request.locale %}
    {% trans_default_domain 'courses' %}

    <video class="background-video" autoplay loop muted>
        <source src="{{ asset('build/images/base/hello_world.mp4') }}" type="video/mp4">
    </video>

    {% include 'widgets/_section_choices.html.twig' with {
        'page_title': ('courses.introduction.title')|trans,
        'boxes': [
            {
                'title': ('courses.introduction.part_1.title')|trans,
                'paragraphs': [
                    ('courses.introduction.part_1.paragraph_1')|trans,
                    ('courses.introduction.part_1.paragraph_2')|trans,
                    ('courses.introduction.part_1.paragraph_3')|trans
                ]
            },
            {
                'title': ('courses.introduction.part_2.title')|trans,
                'paragraphs': [
                    ('courses.introduction.part_2.paragraph_1')|trans
                ],
                'color': 'secondary'
            },
        ],
        'contact_button': true
    } %}

    <div class="transparent-box even bottom-secondary"></div>

    <section class="section-container section-container-secondary">
        {% include 'widgets/_section_presentation.html.twig' with {
            'title': ('courses.title')|trans,
            'subtitle': ('courses.subtitle')|trans,
            'cards': [
                {
                    'href': '#oop-uml-scm',
                    'media': {
                        'src': asset('build/images/base/oop-uml-scm.svg'),
                        'alt': ('oop-ulm-scm')|trans({}, 'alt')
                    },
                    'description': 'OOP - UML - SCM'
                },
                {
                    'href': '#html5-css3',
                    'media': {
                        'src': asset('build/images/base/html5-css3.svg'),
                        'alt': ('html5-css3')|trans({}, 'alt')
                    },
                    'description': 'HTML5 - CSS3'
                },
                {
                    'href': '#symfony2',
                    'media': {
                        'src': asset('build/images/base/symfony2.svg'),
                        'alt': ('symfony2')|trans({}, 'alt')
                    },
                    'description': 'Symfony'
                }
            ]
        } %}
    </section>

    <div class="transparent-box top-secondary"></div>

    {% for course in courses %}
        {% include 'widgets/_section_display.html.twig' with {
            'title': course.name,
            'id': course.id,
            'media': {
                'src': course.media,
                'alt': (course.id)|trans({}, 'alt')
            },
            'buttons': [
                {
                    'label': ('button.pdf_download')|trans({}, 'messages'),
                    'href': url('app_courses_show', {'slug' : course.id})
                },
                {
                    'label': ('button.contact_us')|trans({}, 'messages'),
                    'href': url('app_contact_index')
                }
            ],
            'tabs': course.days,
            'duration': ('courses.duration')|trans,
            'hour': ('courses.hour')|trans,
        } %}
    {% endfor %}
{% endblock %}