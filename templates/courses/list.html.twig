{% extends 'layout.html.twig' %}

{% block title %}Solutions de formation{% endblock %}

{% block main %}
    {% trans_default_domain 'courses' %}

    <video class="background-video" autoplay loop muted>
        <source src="{{ asset('build/images/base/hello_world.mp4') }}" type="video/mp4">
    </video>

    {% include 'widgets/_section_choices.html.twig' with {
        'page_title': ('courses.introduction.title')|trans,
        'boxes': [
            {
                'title': ('courses.introduction.part_1.title')|trans,
                'paragraphs': [
                    ('courses.introduction.part_1.paragraph_1')|trans,
                    ('courses.introduction.part_1.paragraph_2')|trans,
                    ('courses.introduction.part_1.paragraph_3')|trans
                ]
            },
            {
                'title': ('courses.introduction.part_2.title')|trans,
                'paragraphs': [
                    ('courses.introduction.part_2.paragraph_1')|trans,
                    ('courses.introduction.part_2.paragraph_2')|trans,
                    ('courses.introduction.part_2.paragraph_3')|trans
                ],
                'color': 'secondary'
            },
        ],
        'contact_button': true
    } %}

    <div class="transparent-box even"></div>

    <section class="section-container section-container-90 section-container-primary">
        <section class="section-presentation section-word-cloud">
            <h2 class="section-presentation-title idci-title-primary">Quelques notions que nous maîtrisons :</h2>
            <div class="word-cloud">
                <div class="word word-big word-green">Symfony</div>
                <div class="word word-big">PHP</div>
                <div class="word word-big">HTML</div>
                <div class="word word-big">CSS</div>
                <div class="word word-blue">Docker</div>
                <div class="word word-small">Gestion de projet</div>
                <div class="word word-big">Git</div>
                <div class="word word-big">Programmation Orientée Objet</div>
                <div class="word word-big">Applications Web</div>
                <div class="word word-big">SASS</div>
                <div class="word word-big">SQL</div>
                <div class="word word-blue">GitLab</div>
                <div class="word word-big">Versioning</div>
                <div class="word word-small">Architecture MVC</div>
                <div class="word word-big">Front-End</div>
                <div class="word word-big">Back-End</div>
                <div class="word word-big">Fullstack</div>
                <div class="word word-big">Développement Web</div>
            </div>
        </section>
    </section>
{% endblock %}