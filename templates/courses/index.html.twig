{% extends 'layout.html.twig' %}

{% block main %}

<section class="section-container">
    <section class="section-presentation">
        <h2 class="section-presentation-title idci-title-primary">Choisissez l'une de</h2>
        <h3 class="section-presentation-subtitle idci-subtitle-primary">nos formations</h3>
        <div class="columns section-presentation-columns">
            <div class="column section-presentation-column">
                <div class="section-card">
                    <img src="{{ asset('build/images/base/oop-uml-scm.svg') }}" class="section-card-media">
                    <p class="section-card-description">OOP - UML - SCM</p>
                </div>
            </div>
            <div class="column">
                <div class="section-card">
                    <img src="{{ asset('build/images/base/html5-css3.svg') }}" class="section-card-media">
                    <p class="section-card-description">Html5 - CSS3</p>
                </div>
            </div>
            <div class="column">
                <div class="section-card">
                    <img src="{{ asset('build/images/base/symfony2.svg') }}" class="section-card-media">
                    <p class="section-card-description">Symfony</p>
                </div>
            </div>
        </div>
    </section>
</section>

{% for course in courses %}
<section class="section-container section-container-full section-container-{% if 0 == loop.index % 2 %}secondary{% else %}primary{% endif %}">
    <section class="section-display">
        <h2 class="section-display-title idci-title-primary">{{ course.name }}</h2>
        <section class="section-display-content">
            <aside class="section-display-aside">
                <img src="{{ asset('build/images/' ~ course.media ~ '') }}" class="section-card-media">
                <div class="section-display-aside-buttons">
                    <a href="" class="button section-display-aside-button">Télécharger en PDF</a>
                    <a href="{{ url('app_contact_index') }}" class="button section-display-aside-button">Nous contacter</a>
                </div>
            </aside>
            <article class="section-display-article">
                <div class="tab">
                    {% for day in course.days %}
                    <div class="tab-item">
                        <input type="radio" id="{{ (course.name ~ '-' ~ day.label)|slug }}" name="{{ course.name|slug }}-nav-tab" {% if 1 == loop.index %}checked{% endif %}>
                        <label for="{{ (course.name ~ '-' ~ day.label)|slug }}" data-position="{{ loop.index }}">{{ day.label }}</label>
                        <div class="tab-pane">
                            {% for item in day.items %}
                                <p class="section-display-article-tab-title idci-title-secondary">{{ item.title }}</p>
                                {% if 0 != item.duration %}
                                <p class="section-display-article-tab-subtitle idci-title-secondary">Durée : {{ item.duration / 60 }} heure{% if item.duration > 60 %}s{% endif %}</p>
                                {% endif %}
                                <ul class="section-display-article-tab-list">
                                    {{ item.description|raw }}
                                </ul>
                            {% endfor %}
                        </div>
                    </div> 
                    {% endfor %}
                </div>
            </article>
        </section>
    </section>
</section>
{% endfor %}

{% endblock %}