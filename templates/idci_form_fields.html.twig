{% extends 'form_div_layout.html.twig' %}

{% block form_errors %}
    {% spaceless %}
        {% if errors|length > 0 %}
            <ul class="form-error-alert">
                {% for error in errors %}
                    <li>
                        <div data-alert class="alert-box secondary">
                            <p>
                                {{
                                error.messagePluralization is null
                                ? error.messageTemplate|trans(error.messageParameters, 'validators')
                                : error.messageTemplate|transchoice(error.messagePluralization, error.messageParameters, 'validators')
                                }}
                            </p>
                            <a class="close">&times;</a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endspaceless %}
{% endblock form_errors %}

{% block form_widget_simple %}
    {% set juro_class = juro_class|default('input__field input__field--juro ') %}
    {% set type = type|default('text') %}
    <input class="{{ juro_class }}" type="{{ type }}" {{ block('widget_attributes') }}
        {% if value is not empty %}
            value="{{ value }}"
        {% endif %}
    />
{% endblock form_widget_simple %}

{% block textarea_widget %}
    {% spaceless %}
        <textarea class="input__field input__field--juro" {{ block('widget_attributes') }}>{{ value }}</textarea>
    {% endspaceless %}
{% endblock textarea_widget %}

{% block form_row %}
    {% if label is same as('captcha') %}
        {% set juro_container_class = juro_container_class|default('input input--juro juro-captcha') %}
        <div class="captcha-input-container">
            <div class="{{ juro_container_class }}">
                {{ form_widget(form) }}
                {{ form_label(form) }}
            </div>
            {% if label is same as('captcha') %}
                {% if is_human %}
                -
                {% else %}
                {% spaceless %}
                    <img class="captcha_image" id="{{ image_id }}" src="{{ captcha_code }}" alt="" title="captcha" width="{{ captcha_width }}" height="{{ captcha_height }}" />
                    {% if reload %}
                    <script type="text/javascript">
                        function reload_{{ image_id }}() {
                            var img = document.getElementById('{{ image_id }}');
                            img.src = '{{ captcha_code }}?n=' + (new Date()).getTime();
                        }
                    </script>
                    <a class="captcha_reload" href="javascript:reload_{{ image_id }}();">{{ 'Renew'|trans({}, 'gregwar_captcha') }}</a>
                    {% endif %}
                {% endspaceless %}
                {% endif %}
            {% endif %}
        </div>
    {% else %}
        {% set juro_container_class = juro_container_class|default('input input--juro') %}
        <div class="{{ juro_container_class }}">
            {{ form_widget(form) }}
            {{ form_label(form) }}
        </div>
    {% endif %}
    
    
{% endblock form_row %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% if not compound %}
            {% set label_attr = label_attr|merge({'for': id}) %}
        {% endif %}
        {% if required %}
            {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' required')|trim}) %}
        {% endif %}
        {% if label is empty %}
            {% if label_format is not empty %}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {% else %}
                {% set label = name|humanize %}
            {% endif %}
        {% endif %}
        <label {% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}{% if attrname == 'class' %} input__label input__label--juro{% endif %}"{% endfor %}>
            <span class="input__label-content input__label-content--juro">
                {{ label|trans({}, translation_domain) }}
            </span>            
            {{ form_errors(form) }}
        </label>
    {% endif %}
{% endblock form_label %}

{% block captcha_widget %}
     {{ form_widget(form) }}
{% endblock %}

{% block button_widget %}{% spaceless %}
    <div class="form_button">
        <button type="submit" id="contact_submit" class="idci-button">{% trans %}button.contact.submit{% endtrans %}</button>
    </div>
{% endspaceless %}{% endblock button_widget %}