<!DOCTYPE html>
<html>
    <head>
        <title>{% block title%}IDCI-Consulting{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"/>
        {% block stylesheets %}{% endblock %}

    </head>

    <body>
        {% include 'flashMessage.html.twig' %}
        <div class="wrapper">
            {% block header %}{% endblock %}
            {% block content %}{% endblock %}
            {% block footer %}{% endblock %}
        </div>

        {% block javascripts %}
            {% if app.debug %}
                <script src="http://127.0.0.1:35729/livereload.js?ext=Chrome&amp;extver=2.1.0"></script>
                <script src="{{ asset('js/jquery.min.js') }}"></script>
                <script src="{{ asset('js/modernizr.js') }}"></script>
                <script src="{{ asset('js/foundation.min.js') }}"></script>
                <script src="{{ asset('js/init/init.js') }}"></script>
                <script src="{{ asset('js/idciScripts/end.js') }}"></script>
                <script src="{{ asset('js/idciScripts/flashMessages.js') }}"></script>
                <script src="{{ asset('js/idciScripts/scrollTo.js') }}"></script>
                <script src="{{ asset('js/idciScripts/slick.js') }}"></script>
                <script src="{{ asset('js/idciScripts/tabs.js') }}"></script>
                <script src="{{ asset('js/formFieldsEffects/classie.js') }}"></script>
                <script src="{{ asset('js/formFieldsEffects/focusFieldEffect.js') }}"></script>
                <script src="{{ asset('js/accordionHandler/accordion.js') }}"></script>
                <script src="{{ asset('js/headerHandler/animateHamburgerMenu.js') }}"></script>
                <script src="{{ asset('js/headerHandler/navHandler.js') }}"></script>
                <script src="{{ asset('js/slick.js') }}"></script>
            {% block devJavascripts %}{% endblock %}
            {% else %}
                <script src="{{ asset('js/' ~ getRevFilename('app.min.js') ~ '') }}"></script>
            {% endif %}
            <script src="{{ asset('plugins/ace-editor/ace.js') }}" type="text/javascript" charset="utf-8"></script>
        {% endblock %}
    </body>
</html>