<!DOCTYPE html>
<html>
    <head>
        <title>{% block title%}IDCI-Consulting{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('images/favicon.png') }}">
        {% block stylesheets %}{% endblock %}
        {% if app.debug %}
            <script src="{{ asset('js/jquery.js') }}"></script>
        {% else %}
            <script src="{{ asset('js/' ~ getRevFilename('jquery.min.js') ~ '') }}"></script>
        {% endif %}
    </head>

    <body>
        {% include 'flashMessage.html.twig' %}
        <div class="wrapper">
            {% block header %}{% endblock %}
            {% block content %}{% endblock %}
            {% block footer %}{% endblock %}
        </div>

        {% block javascripts %}
            {% if app.debug %}
                <script src="http://127.0.0.1:35729/livereload.js?ext=Chrome&amp;extver=2.1.0"></script>
                <script src="{{ asset('js/modernizr.js') }}"></script>
                <script src="{{ asset('js/foundation.min.js') }}"></script>
                <script src="{{asset('js/formFieldsEffects/classie.js') }}"></script>
                <script src="{{asset('js/formFieldsEffects/focusFieldEffect.js') }}"></script>
                <script src="{{asset('js/accordionHandler/accordion.js') }}"></script>
                <script src="{{asset('js/init/init.js') }}"></script>
                <script src="{{asset('js/menuHandler/animateHamburgerMenu.js') }}"></script>
                <script src="{{asset('js/headerHandler/navHandler.js') }}"></script>
            {% block devJavascripts %}{% endblock %}
            {% else %}
                <script src="{{ asset('js/' ~ getRevFilename('app.min.js') ~ '') }}"></script>
            {% endif %}
        {% endblock %}
    </body>
</html>