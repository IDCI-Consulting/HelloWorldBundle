{% trans_default_domain 'members' %}

<section class="section-container section-container-90">
    <section class="section-members">
        <h1 class="section-members-title idci-subtitle-primary">{{ title }}</h1>
        <p class="section-members-introduction">{{ description|raw }}</p>
        <div class="section-members-list">
            {% for member in members %}
                <div class="section-member-card">
                    <h2 class="section-member-card-title idci-title-primary">{{ (member ~ '.name')|trans }}</h2>
                    <h3 class="section-member-card-subtitle idci-subtitle-secondary">{{ (member ~ '.subtitle')|trans }}</h3>
                    <img src="{{ asset('build/images/members/' ~ member ~ '-sprite.png') }}" alt="{{ (member ~ '-sprite')|trans({}, 'alt') }}" class="section-member-card-media">
                    <p class="section-member-card-description">{{ (member ~ '.description')|trans }}</p>
                    <a href="{{ url('app_team_member', {'slug' : '' ~ (member ~ '.name')|trans|lower|slug('_')}) }}" class="button section-member-card-button">{{ ('members.check_cv')|trans }}</a>
                </div>
            {% endfor %}
        </div>
    </section>
</section>