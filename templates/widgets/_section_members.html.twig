{% trans_default_domain 'members' %}

<section class="section-members">
    <section class="content-container">
        <h1 class="section-members-title idci-subtitle-primary">{{ title }}</h1>
        <p class="section-members-introduction">{{ description|raw }}</p>
        <div class="section-members-list">
            {% for member in members %}
                <div class="section-member-card">
                    <h2 class="section-member-card-title idci-title-primary">{{ member }}</h2>
                    <h3 class="section-member-card-subtitle idci-subtitle-secondary">{{ (member|lower|split(' ')|first ~ '.subtitle')|trans }}</h3>
                    <img src="{{ asset('build/images/members/' ~ member|lower|split(' ')|first ~ '.jpg') }}" alt="{{ (member|lower|split(' ')|first ~ '-sprite')|trans({}, 'alt') }}" class="section-member-card-media">
                    <p class="section-member-card-description">{{ (member|lower|split(' ')|first ~ '.description')|trans|raw }}</p>
                    <a href="{{ url('app_team_member', {'slug' : (member)|lower|slug('_')}) }}" class="button section-member-card-button">{{ ('members.check_cv')|trans }}</a>
                </div>
            {% endfor %}
        </div>
    </section>
</section>
