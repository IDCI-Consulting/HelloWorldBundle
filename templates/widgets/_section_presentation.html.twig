<section class="section-presentation{% if background_media is defined and background_media is same as (true) %} section-presentation-media{% endif %}{% if background_secondary is defined and background_secondary is same as (true) %} section-presentation-background-secondary{% endif %}"{% if id is defined and id is not null and id is not empty %} id="{{ id }}"{% endif %}>
    <div class="content-container">
        {% if title is defined and title is not null and title is not empty %}
            <h2 class="section-presentation-title idci-title-primary">{{ title }}</h2>
        {% endif %}
        <h3 class="section-presentation-subtitle idci-subtitle-primary">{{ subtitle }}</h3>
        {% if media is defined and media is not null and media is not empty %}
            <img src={{ media.src }} alt={{ media.alt }} class="section-presentation-media">
        {% endif %}
        {% if paragraphs is defined and paragraphs is not null and paragraphs is not empty %}
            {% for paragraph in paragraphs %}
                <p class="section-presentation-description {% if tags is defined and tags is same as true %}section-presentation-tags{% endif %}">
                    {{ paragraph|raw }}
                </p>
            {% endfor %}
        {% endif %}
        {% if cards is defined and cards is not null and cards is not empty %}
            <div class="columns section-presentation-columns">
                {% for card in cards %}
                    <div class="column section-presentation-column">
                        <div class="section-card">
                            <a href={{ card.href }} class="section-card-link">
                                <img src="{{ card.media.src }}" alt={{ card.media.alt }} class="section-card-media">
                                <p class="section-card-description">{{ card.description }}</p>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% block widget %}
        {% endblock %}
    </div>
</section>