<section class="section-display-stack{% if nav_element is defined and nav_element is same as (true) %} section-navigation{% endif %}"{% if id is defined and id is not null and id is not empty %} id="{{ id }}"{% endif %}>
    <div class="content-container">
        <div class="section-display-stack-colored-box"></div>
        <div class="section-display-stack-description">
            <h2 class="section-display-stack-description-title">{{ title }}</h2>
            {% for paragraph in paragraphs %}
                <p class="section-display-stack-description-content">
                    {{ paragraph|raw }}
                </p>
            {% endfor %}
        </div>
        <img class="section-display-stack-media" src="{{ media.src }}" alt="{{ media.alt }}">
    </div>
</section>