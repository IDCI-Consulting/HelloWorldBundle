<section class="section-container section-container-90 section-container-primary">
    <section class="section-presentation section-word-cloud">
        <h2 class="section-presentation-title idci-title-primary">{{ title }} :</h2>
        <ul class="section-word-cloud-list">
            {% for element in elements %}
                <li class="section-word-cloud-list-item{% if loop.index is divisible by(3.5) %} section-word-cloud-list-item-blue{% endif %}{% if loop.index is divisible by(5.5) %} section-word-cloud-list-item-green{% endif %}{% if loop.index is divisible by(5) %} section-word-cloud-list-item-big{% endif %}{% if loop.index is divisible by(7) %} section-word-cloud-list-item-small{% endif %}">{{ element }}</li>
            {% endfor %}
        </ul>
    </section>
</section>