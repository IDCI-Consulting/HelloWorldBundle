{% extends 'layout.html.twig' %}

{% block title %}Présentation de nos offres{% endblock %}

{% block main %}
    {% trans_default_domain 'offers' %}

    <video class="background-video" autoplay loop muted>
        <source src="{{ asset('build/images/base/network.mp4') }}" type="video/mp4">
    </video>

    {% include 'widgets/_section_choices.html.twig' with {
        'page_title': ('offers.section_4.title')|trans,
        'boxes': [
            {
                'title': ('offers.section_4.box_1.title')|trans,
                'paragraphs': [
                    ('offers.section_4.box_1.description')|trans
                ]
            },
            {
                'title': ('offers.section_4.box_2.title')|trans,
                'paragraphs': [
                    ('offers.section_4.box_2.description')|trans
                ],
                'color': 'secondary'
            }
        ]
    } %}

    <div class="transparent-box even"></div>

    {% include 'widgets/_section_choices.html.twig' with {
        'title': ('offers.section_3.title')|trans,
        'subtitle': ('offers.section_3.subtitle')|trans,
        'boxes': [
            {
                'title': '<span class="colored">01</span>',
                'paragraphs': [
                    ('offers.section_3.box_1.description')|trans
                ],
                'secondary': true
            },
            {
                'title': '<span class="colored">02</span>',
                'paragraphs': [
                    ('offers.section_3.box_2.description')|trans
                ],
                'secondary': true
            },
            {
                'title': '<span class="colored">03</span>',
                'paragraphs': [
                    ('offers.section_3.box_3.description')|trans
                ],
                'secondary': true
            }
        ]
    } %}

    <div class="transparent-box"></div>

    {% include 'widgets/_section_display_stack.html.twig' with {
        'title': 'offers.section_2.title'|trans,
        'paragraphs': [
            'offers.section_2.description'|trans
        ],
        'media': {
            'src': asset('build/images/base/working-on-computer.jpg'),
            'alt': 'working-on-computer'|trans({}, 'alt')
        }
    } %}

    <div class="transparent-box even"></div>

    {% include 'widgets/_section_choices.html.twig' with {
        'boxes': [
            {
                'title': ('offers.section_1.box_1.title')|trans,
                'paragraphs': [
                    ('offers.section_1.box_1.description')|trans
                ]
            },
            {
                'title': ('offers.section_1.box_2.title')|trans,
                'paragraphs': [
                    ('offers.section_1.box_2.description')|trans
                ],
                'color': 'secondary'
            },
        ],
        'contact_button': true
    } %}
{% endblock %}