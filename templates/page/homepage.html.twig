{% extends 'layout.html.twig' %}

{% block title %}IDCI Consulting - Création d'applications web - Formations - Conseil{% endblock %}

{% block main %}
    {% trans_default_domain 'homepage' %}

    <div class="navbox" id="navbox">
        <ul>
            <li class="active"><a href="#specialization"> {{ 'specialization.subtitle'|trans }} </a><i class="fa-solid fa-circle fa-xs"></i></li>
            <li><a href="#innovation"> {{ 'company_concept.title'|trans }} </a><i class="fa-solid fa-circle fa-xs"></i></li>
            <li><a href="#methodology">{{ 'methodology.subtitle'|trans }}</a><i class="fa-solid fa-circle fa-xs"></i></li>
            <li><a href="#tools">{{ 'tools.subtitle'|trans }}</a><i class="fa-solid fa-circle fa-xs"></i></li>
        </ul>
    </div>

    <video class="background-video" autoplay loop muted>
        <source src="{{ asset('build/images/base/typing.mp4') }}" type="video/mp4">
    </video>

    {% embed 'widgets/_section_presentation.html.twig' with {
        'nav_element': true,
        'background_media': true,
        'id': 'specialization',
        'title': 'specialization.title'|trans,
        'subtitle': 'specialization.subtitle'|trans,
        'paragraphs': [
            'specialization.paragraph_1'|trans
        ],
        'button': {
            'href': '#consulting'
        },
        'tags': true,
    } %}
        {% block widget %}
            {% trans_default_domain 'homepage' %}
            {% include 'widgets/_section_choices.html.twig' with {
                'title': '',
                'subtitle': '',
                'boxes': [
                    {
                        'title': ('call_to_action.box_1.title')|trans,
                        'paragraphs': [
                            ('call_to_action.box_1.paragraph_1')|trans,
                            ('call_to_action.box_1.paragraph_2')|trans,
                            ('call_to_action.box_1.paragraph_3')|trans,
                            ('call_to_action.box_1.paragraph_4')|trans
                        ]
                    },
                    {
                        'title': ('call_to_action.box_2.title')|trans,
                        'paragraphs': [
                            ('call_to_action.box_2.paragraph_1')|trans,
                            ('call_to_action.box_2.paragraph_2')|trans,
                            ('call_to_action.box_2.paragraph_3')|trans,
                            ('call_to_action.box_2.paragraph_4')|trans,
                        ],
                        'color': 'secondary'
                    },
                ]
            } %}
        {% endblock %}
    {% endembed %}

    {% include 'widgets/_section_display_stack.html.twig' with {
        'nav_element': true,
        'id': 'innovation',
        'title': 'company_concept.title'|trans,
        'paragraphs': [
            'company_concept.description'|trans
        ],
        'media': {
            'src': asset('build/images/base/working-on-computer.jpg'),
            'alt': 'working-on-computer'|trans({}, 'alt')
        }
    } %}

    <div class="transparent-box"></div>

    {% include 'widgets/_section_presentation.html.twig' with {
        'nav_element': true,
        'id': 'methodology',
        'background_secondary': true,
        'subtitle': 'methodology.subtitle'|trans,
        'paragraphs': [
            'methodology.paragraph_1'|trans,
            'methodology.paragraph_2'|trans,
            'methodology.paragraph_3'|trans
        ],
        'media': {
        'src': asset('build/images/base/agile.svg'),
        'alt': 'agile'|trans({}, 'alt')
        }
    } %}

