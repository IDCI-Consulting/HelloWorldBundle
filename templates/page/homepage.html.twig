                    </ul>
                </div>
                <div class="column section-presentation-column">
                    <p class="section-presentation-column-title idci-title-primary">{% trans from "homepage" %}tools.column_2{% endtrans %}</p>
                    <ul class="section-presentation-column-list">
                        <li><a href="https://phpunit.de/" target="_blank"><img src="{{ asset('build/images/logo/phpunit-logo.png') }}" alt="{% trans from "alt" %}phpunit-logo{% endtrans %}" class="section-presentation-column-media"></a></li>
