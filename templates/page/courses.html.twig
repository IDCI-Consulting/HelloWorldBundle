{% extends 'layout.html.twig' %}

{% block title %}Solutions de formation{% endblock %}

{% block main %}
    {% trans_default_domain 'courses' %}

    <video class="background-video" autoplay loop muted>
        <source src="{{ asset('build/images/base/hello_world.mp4') }}" type="video/mp4">
    </video>

    {% include 'widgets/_section_choices.html.twig' with {
        'page_title': ('courses.introduction.title')|trans,
        'boxes': [
            {
                'title': ('courses.introduction.problematics.title')|trans,
                'paragraphs': [
                    ('courses.introduction.problematics.paragraph_1')|trans,
                    ('courses.introduction.problematics.paragraph_2')|trans,
                    ('courses.introduction.problematics.paragraph_3')|trans
                ]
            },
            {
                'title': ('courses.introduction.solutions.title')|trans,
                'paragraphs': [
                    ('courses.introduction.solutions.paragraph_1')|trans,
                    ('courses.introduction.solutions.paragraph_2')|trans,
                    ('courses.introduction.solutions.paragraph_3')|trans
                ],
                'color': 'secondary'
            },
        ],
        'contact_button': true
    } %}

    <div class="transparent-box even"></div>

    {% set tags = [
        'SASS', 'PHP', 'HTML', 'CSS', 'Docker', 'courses.key_words.project_management'|trans, 'Git', 'courses.key_words.oop'|trans,
        'courses.key_words.web_app'|trans, 'Symfony', 'SQL', 'GitLab', 'Versionning', 'courses.key_words.mvc'|trans, 'Fullstack', 'Back-End', 'Front-End',
        'courses.key_words.web_dev'|trans, 'Responsive Design', 'CI/CD', 'Microservices'
    ] %}

    {% include 'widgets/_section_tagcloud.html.twig' with {
        'title': 'courses.key_words.title'|trans,
        'tags': tags
    } %}
{% endblock %}