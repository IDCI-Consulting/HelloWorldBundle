{% extends "layout.html.twig" %}
{% trans_default_domain 'courses' %}

{% block nav %}
    {% include 'menu.html.twig' with {
    'menu': menu,
    'active': 'website_courses'
    } %}
{% endblock %}

{% block main_content %}
    <header class="content-header">
        <em>{% trans %}title.course.sub{% endtrans %}</em>
        <h1 class="title">{% trans %}title.courses{% endtrans %}</h1>
    </header>

    <input checked="checked" class="collapse-checkbox symfony2" id="symfony2-checkbox" type="radio" name="courses-choice"/>
    <input class="collapse-checkbox oop-uml-scm" id="oop-uml-scm-checkbox" type="radio" name="courses-choice"/>
    <input class="collapse-checkbox html5-css3" id="html5-css3-checkbox" type="radio" name="courses-choice"/>
    <input class="collapse-checkbox wordpress" id="wordpress-checkbox" type="radio" name="courses-choice"/>
    <section class="course-choice">
    {% for course in courses %}
        <label for="{{ course.name }}-checkbox" class="course-box">
            <article class="{{ course.name }}">
                <div class="choice-content">
                    {{ file_get_public_contents('build/images/' ~ course.name ~'.svg') |raw }}
                    <p class="course-title"> {{ course.title }} </p>
                </div>
            </article>
        </label>
    {% endfor %}
    </section>

    {% for course in courses %}
        <section class="course {{ course.name }}" id="{{ course.name }}">
            <h2> {{ course.title }} </h2>
            <aside class="course-title">
                {{ file_get_public_contents('build/images/' ~ course.name ~'.svg') |raw }}
                <a href="" class="idci-button">{% trans %}button.courses.download{% endtrans %} </a>
                <a href="{{ url('website_contact') }}" class="idci-button">{% trans %}button.courses.contact{% endtrans %}</a>
            </aside>
            <article class="course-content">
                <div class="button-group">

                </div>
                <ul class="courses-summary">

                </ul>
            </article>
        </section>
    {% endfor %}

{% endblock %}
