{% extends "layout.html.twig" %}
{% trans_default_domain 'references' %}

{% block nav %}
    {% include 'menu.html.twig' with {
    'menu': menu,
    'active': 'website_references'
    } %}
{% endblock %}

{% block main_content %}

    <header class="title">
        <h1>{% trans %}title.references{% endtrans %}</h1>
    </header>
    {% for work in achievements %}
        <section class="activities">
            <article class="activities-content">
                <img src="{{ asset(work.image_path) }}"/>
                <h2>{% trans %}title.references.project{% endtrans %}</h2>
                <p>{{ work.content[app.request.locale] }}</p>
            </article>
            <article class="activities-skills">
                <h2>{% trans %}title.references.expertise{% endtrans %}</h2>
                <ul>
                    {% for service in work.services %}
                        <li>{{ file_get_public_contents('build/images/' ~ service ~'.svg') |raw }}</li>
                    {% endfor %}
                </ul>
                <h2>{% trans %}title.references.tools{% endtrans %}</h2>
                <ul>
                    {% for tool in work.tools %}
                        <li>{{ file_get_public_contents('build/images/' ~ tool ~'.svg') |raw }}</li>
                    {% endfor %}
                </ul>
            </article>
        </section>
    {% endfor %}

{% endblock %}
