{% extends "layout.html.twig" %}
{% trans_default_domain 'home' %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'website_home'
    } %}
{% endblock %}

{% block main_content %}
    <video autoplay muted loop>
        <source src="{{asset('build/images/typing.mp4')}}" type="video/mp4">
    </video>
    <section id="{% trans %}presentation{% endtrans %}" class="container presentation">
        <header class="header-presentation">
            <em>{% trans %}We specialize in{% endtrans %}</em class="sub-title">
            <h2>
                {% trans %}Web architecture{% endtrans %},
                {% trans %}PHP{% endtrans %}
                &
                {% trans %}Symfony{% endtrans %}
            </h2>
            <p>&lt;{% trans %}Engineering{% endtrans %}&gt;</p>
            <p>&lt;{% trans %}Development{% endtrans %}&gt;</p>
            <p>&lt;{% trans %}Consulting{% endtrans %}&gt;</p>
            <p>&lt;{% trans %}Integration{% endtrans %}&gt;</p>
        </header>
        <a class="scroll-to" href="#{% trans %}advice{% endtrans %}">
            <span></span>
        </a>
    </section>
    <div class="parallax-video top-advices">
        <div class="top-box"></div>
    </div>
    <section id="{% trans %}advice{% endtrans %}" class="container advices">
        <input type="checkbox" id="advice-checkbox" class="collapse-checkbox">
        <label for="advice-checkbox">
            <header>
                <em class="sub-title">{% transchoice 2 from "messages" %}We do{% endtranschoice %}</em class="sub-title">
                <img src="{{ asset("build/images/conseil.svg") }}" class="accordion-image" alt="{% trans %}advice accordion-image{% endtrans %}"/>
                <h2>
                    {% trans %}Consulting{% endtrans %}
                </h2>
                <i class="fas fa-angle-down"></i>
            </header>
        </label>
        <img src="{{ asset("build/images/conseil.svg") }}" class="index-image" alt="{% trans %}advice icon{% endtrans %}"/>
        <article class="content">{% include 'contents/index/advice_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>
    <div class="parallax-video">
        <div class="bottom-box switched"></div>
        <div class="top-box switched"></div>
    </div>
    <section id="{% trans %}training{% endtrans %}" class="container training">
        <input type="checkbox" id="training-checkbox" class="collapse-checkbox">
        <label for="training-checkbox">
            <header>
                <em class="sub-title">{% transchoice 1 from "messages" %}We do{% endtranschoice %}</em class="sub-title">
                <img src="{{ asset("build/images/formation.svg") }}" class="accordion-image" alt="{% trans %}training accordion-image{% endtrans %}"/>
                <h2>
                    {% trans %}Training{% endtrans %}
                </h2>
                <i class="fas fa-angle-down"></i>
            </header>
        </label>
        <img src="{{ asset("build/images/formation.svg") }}" class="index-image" alt="{% trans %}training icon{% endtrans %}"/>
        <article class="content">{% include 'contents/index/training_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>
    <div class="parallax-video">
        <div class="bottom-box"></div>
        <div class="top-box"></div>
    </div>
    <section id="{% trans %}web-development{% endtrans %}" class="container development">
        <input type="checkbox" id="development-checkbox" class="collapse-checkbox">
        <label for="development-checkbox">
            <header>
                <em class="sub-title">{% transchoice 2 from "messages" %}We do{% endtranschoice %}</em class="sub-title">
                <img src="{{ asset("build/images/icon_dev.svg") }}" class="accordion-image" alt="{% trans %}web development accordion-image{% endtrans %}"/>
                <h2>
                    {% trans %}Web development{% endtrans %}
                </h2>
                <i class="fas fa-angle-down"></i>
            </header>
        </label>
        <pre id="editor"></pre>
        <article class="content">{% include 'contents/index/development_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>
    <div class="parallax-video">
        <div class="bottom-box switched"></div>
        <div class="top-box switched"></div>
    </div>
    <section id="{% trans %}philosophy{% endtrans %}" class="container philosophy">
        <input type="checkbox" id="philosophy-checkbox" class="collapse-checkbox">
        <label for="philosophy-checkbox">
            <header>
                <em class="sub-title">{% trans %}Our philosophy{% endtrans %}</em class="sub-title">
                <img src="{{ asset('build/images/opensource.svg') }}" class="accordion-image" alt="{% trans %}opensource accordion-image{% endtrans %}"/>
                <h2>
                    {% trans %}Open source{% endtrans %}
                </h2>
                <i class="fas fa-angle-down"></i>
            </header>
        </label>
        <img src="{{ asset('build/images/opensource.svg') }}" class="index-image" alt="{% trans %}opensource icon{% endtrans %}"/>
        <article class="content">{% include 'contents/index/philosophy_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>
    <div class="parallax-video">
        <div class="bottom-box"></div>
        <div class="top-box"></div>
    </div>
    <section id="{% trans %}approach{% endtrans %}" class="container approach">
        <header>
            <h2>
                {% trans %}Our methodology{% endtrans %}
            </h2>
        </header>
        <img src="{{ asset('build/images/agile.svg') }}" class="index-image" alt="{% trans %}agile icon{% endtrans %}"/>
        <article class="content">{% include 'contents/index/approach_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>
    <div class="parallax-video">
        <div class="bottom-box switched"></div>
        <div class="top-box switched"></div>
    </div>
    <section id="{% trans %}tools{% endtrans %}" class="container tools">
        <header>
            <h2>
                {% trans %}Our tools{% endtrans %}
            </h2>
            <img class="tools-icon" src="{{ asset('build/images/icon_outils.svg') }}" class="index-image" alt="{% trans %}tools icon{% endtrans %}"/>
        </header>
        <ul class="content">
            {% for tool in tools|shuffle %}
                <li class="tool-part">
                    <a href="{{ tool.url }}" title="{{ tool.title }}" target="_blank">
                        {{ file_get_public_contents('build/images/' ~ tool.label ~'.svg') |raw }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        var idci_code_writer = '{{ idci_code_writer|json_encode|escape("js") }}';
        showAceEditor(idci_code_writer);
    </script>
{% endblock %}
