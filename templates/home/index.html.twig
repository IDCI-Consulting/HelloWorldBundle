{% extends "layout.html.twig" %}
{% trans_default_domain 'home' %}

{% block nav %}
    {% include 'partials/menu.html.twig' with {
    'menu': menu,
    'active': 'website_home'
    } %}
{% endblock %}

{% block main_content %}
    <section id="{% trans %}presentation{% endtrans %}" class="index-part presentation">
        <header class="header-index-part">
            <em>{% trans %}We specialize in{% endtrans %}</em class="index-sub-title">
            <h2>
                {% trans %}Web architecture{% endtrans %},
                {% trans %}PHP{% endtrans %}
                &
                {% trans %}Symfony{% endtrans %}
            </h2>
            <p>&lt;{% trans %}Engineering{% endtrans %}&gt;</p>
            <p>&lt;{% trans %}Development{% endtrans %}&gt;</p>
            <p>&lt;{% trans %}Consulting{% endtrans %}&gt;</p>
            <p>&lt;{% trans %}Integration{% endtrans %}&gt;</p>
        </header>
        <a class="scroll-to" href="#{% trans %}advice{% endtrans %}">
            <span></span>
        </a>
    </section>

    <section id="{% trans %}advice{% endtrans %}" class="index-part advices">
        <header class="header-index-part">
            <em class="index-sub-title">{% transchoice 2 from "messages" %}We do{% endtranschoice %}</em class="index-sub-title">
            <img src="{{ asset("build/images/conseil.svg") }}" class="accordion-image" alt="{% trans %}advice accordion-image{% endtrans %}"/>
            <h2>
                {% trans %}Consulting{% endtrans %}
            </h2>
        </header>
        <img src="{{ asset("build/images/conseil.svg") }}" class="index-image" alt="{% trans %}advice icon{% endtrans %}"/>
        <article class="index-content">{% include 'contents/index/advice_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>

    <section id="{% trans %}training{% endtrans %}" class="index-part training">
        <header class="header-index-part">
            <em class="index-sub-title">{% transchoice 1 from "messages" %}We do{% endtranschoice %}</em class="index-sub-title">
            <img src="{{ asset("build/images/formation.svg") }}" class="accordion-image" alt="{% trans %}training accordion-image{% endtrans %}"/>
            <h2>
                {% trans %}Training{% endtrans %}
            </h2>
        </header>
        <img src="{{ asset("build/images/formation.svg") }}" class="index-image" alt="{% trans %}training icon{% endtrans %}"/>
        <article class="index-content">{% include 'contents/index/training_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>

    <section id="{% trans %}web-development{% endtrans %}" class="index-part development">
        <header class="header-index-part">
            <em class="index-sub-title">{% transchoice 2 from "messages" %}We do{% endtranschoice %}</em class="index-sub-title">
            <img src="{{ asset("images/icon_dev.svg") }}" class="accordion-image" alt="{% trans %}web development accordion-image{% endtrans %}"/>
            <h2>
                {% trans %}Web development{% endtrans %}
            </h2>
        </header>
        <pre id="editor"></pre>
        <article class="index-content">{% include 'contents/index/development_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>

    <section id="{% trans %}philosophy{% endtrans %}" class="index-part philosophy">
        <header class="header-index-part">
            <em class="index-sub-title">{% trans %}Our philosophy{% endtrans %}</em class="index-sub-title">
            <img src="{{ asset('build/images/opensource.svg') }}" class="accordion-image" alt="{% trans %}opensource accordion-image{% endtrans %}"/>
            <h2>
                {% trans %}Open source{% endtrans %}
            </h2>
        </header>
        <img src="{{ asset('build/images/opensource.svg') }}" class="index-image" alt="{% trans %}opensource icon{% endtrans %}"/>
        <article class="index-content">{% include 'contents/index/philosophy_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>

    <section id="{% trans %}approach{% endtrans %}" class="index-part approach">
        <header class="header-index-part">
            <h2>
                {% trans %}Our methodology{% endtrans %}
            </h2>
        </header>
        <img src="{{ asset('build/images/agile.svg') }}" class="index-image" alt="{% trans %}agile icon{% endtrans %}"/>
        <article class="index-content">{% include 'contents/index/approach_' ~ app.request.locale ~ '.html.twig' %}</article>
    </section>

    <section id="{% trans %}tools{% endtrans %}" class="index-part tools">
        <header class="header-index-part">
            <h2>
                {% trans %}Our tools{% endtrans %}
            </h2>
            <img class="tools-icon" src="{{ asset('build/images/icon_outils.svg') }}" class="index-image" alt="{% trans %}tools icon{% endtrans %}"/>
        </header>
        <div class="tools-content">
            <article class="tools-part">
                {%
                    include 'partials/tools.html.twig'
                    with {
                        'class': 'backend',
                        'title': 'Backend',
                        'images': {
                            'php': 'https://secure.php.net',
                            'symfony2': 'http://symfony.com',
                            'node': 'https://nodejs.org',
                            'meteor': 'https://www.meteor.com'
                        }
                    }
                %}
            </article>
            <article class="tools-part">
                {%
                    include 'partials/tools.html.twig'
                    with {
                        'class': 'databases',
                        'title': 'Storage',
                        'images': {
                            'mysql': 'https://www.mysql.fr/',
                            'mongodb': 'https://www.mongodb.org/',
                            'postgresql': 'http://www.postgresql.org/',
                            'redis': 'http://redis.io/',
                            'kyototycoon': 'http://fallabs.com/kyototycoon/api/'
                        }
                    }
                %}
            </article>
            <article class="tools-part">
                {%
                    include 'partials/tools.html.twig'
                    with {
                        'class': 'infrastructure',
                        'title': 'Infrastructure',
                        'images': {
                            'varnish': 'https://www.varnish-cache.org/',
                            'proxmox': 'https://www.proxmox.com/en/',
                            'ansible': 'http://www.ansible.com/home',
                            'elk': 'https://www.elastic.co/fr/products',
                            'docker': 'https://www.docker.com/',
                            'rabbitmq': 'https://www.rabbitmq.com/'
                        }
                    }
                %}
            </article>
            <article class="tools-part">
                {%
                    include 'partials/tools.html.twig'
                    with {
                        'class': 'frontend',
                        'title': 'Frontend',
                        'images': {
                            'html5-css3': 'http://www.w3.org/TR/html5/',
                            'bootstrap': 'http://getbootstrap.com/',
                            'foundation': 'http://foundation.zurb.com/',
                            'angular': 'https://angularjs.org/',
                            'sass': 'http://sass-lang.com/',
                            'jquery': 'https://jquery.com/',
                            'vue-js': 'https://vuejs.org/'

                        }
                    }
                %}
            </article>
            <article class="tools-part">
                {%
                    include 'partials/tools.html.twig'
                    with {
                        'class': 'qualite',
                        'title': 'Quality',
                        'images': {
                            'php-unit': 'https://phpunit.de/',
                            'gitlab': 'https://about.gitlab.com/',
                            'redmine': 'http://www.redmine.org/projects/redmine/wiki',
                        }
                    }
                %}
            </article>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        var idci_code_writer = '{{ idci_code_writer|json_encode|escape("js") }}';
        asideMenuHighlight();
        showAceEditor(idci_code_writer);
    </script>
{% endblock %}
