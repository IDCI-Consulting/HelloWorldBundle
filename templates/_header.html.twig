{% if app.request.attributes.get('_route') is not null %}
    {% set current_route = app.request.attributes.get('_route') %}
    {% set current_route_slug = app.request.attributes.get('slug') %}
{% endif %}

<header class="header">
    <div class="hamburger-menu">
        <input type="checkbox" id="show-mobile-menu" class="show-mobile-menu">
        <label for="show-mobile-menu" class="show-mobile-menu-button fas fa-bars fa-2x">
        </label>
        <div class="mobile-menu">
            <ul class="mobile-menu-list">
                <li class="mobile-menu-list-item {% if 'app_homepage' == current_route|default('') %}active{% endif %}"><a href="{{ url('app_homepage') }}">{% trans from "layout" %}header.homepage{% endtrans %}</a></li>
                <li class="mobile-menu-list-item {% if 'app_offers' == current_route|default('') %}active{% endif %}"><a href="{{ url('app_offers') }}">{% trans from "layout" %}header.offers{% endtrans %}</a></li>
                <li class="mobile-menu-list-item {% if 'app_courses_list' == current_route|default('') or 'app_courses_show' == current_route|default('') %}active{% endif %}"><a href="{{ url('app_courses_list') }}">{% trans from "layout" %}header.courses{% endtrans %}</a></li>
                <li class="mobile-menu-list-item {% if 'app_team_list' == current_route|default('') or 'app_team_member' == current_route|default('') %}active{% endif %}"><a href="{{ url('app_team_list') }}">{% trans from "layout" %}header.members{% endtrans %}</a></li>
                <li class="mobile-menu-list-item {% if 'app_blog_list' == current_route|default('') or 'app_blog_show' == current_route|default('') %}active{% endif %}"><a href="{{ url('app_blog_list') }}">{% trans from "layout" %}header.blog{% endtrans %}</a></li>
                <li class="mobile-menu-list-item {% if 'app_contact_index' == current_route|default('') %}active{% endif %}"><a href="{{ url('app_contact_index') }}">{% trans from "layout" %}header.contact{% endtrans %}</a></li>
            </ul>
        </div>
    </div>
    <div class="header-media">
        <a href="{{ url('app_homepage') }}"><img src="{{ asset('build/images/logo/idci-logo.svg') }}" alt="{% trans from "alt" %}idci-logo{% endtrans %}"></a>
    </div>
    <nav class="header-links">
        <ul class="header-links-list">
            <li class="header-links-list-item"><a href="{{ url('app_homepage') }}" class="{% if 'app_homepage' == current_route|default('') %}active{% endif %}">{% trans from "layout" %}header.homepage{% endtrans %}</a></li>
            <li class="header-links-list-item"><a href="{{ url('app_offers') }}" class="{% if 'app_offers' == current_route|default('') %}active{% endif %}">{% trans from "layout" %}header.offers{% endtrans %}</a></li>
            <li class="header-links-list-item"><a href="{{ url('app_courses_list') }}" class="{% if 'app_courses_list' == current_route|default('') or 'app_courses_show' == current_route|default('') %}active{% endif %}">{% trans from "layout" %}header.courses{% endtrans %}</a></li>
            <li class="header-links-list-item"><a href="{{ url('app_team_list') }}" class="{% if 'app_team_list' == current_route|default('') or 'app_team_member' == current_route|default('') %}active{% endif %}">{% trans from "layout" %}header.members{% endtrans %}</a></li>
            <li class="header-links-list-item"><a href="{{ url('app_blog_list') }}" class="{% if 'app_blog_list' == current_route|default('') or 'app_blog_show' == current_route|default('') %}active{% endif %}">{% trans from "layout" %}header.blog{% endtrans %}</a></li>
            <li class="header-links-list-item"><a href="{{ url('app_contact_index') }}" class="{% if 'app_contact_index' == current_route|default('') %}active{% endif %}">{% trans from "layout" %}header.contact{% endtrans %}</a></li>
        </ul>
    </nav>
    <div class="header-locale">
        <a{% if app.request.locale == 'fr' %} class="active"{% endif %} href="{{ path(current_route|default('app_homepage'), {_locale: 'fr', slug: current_route_slug|default(null)}) }}"><img src="{{ asset('build/images/base/french-flag.png') }}" alt="{% trans from "alt" %}french-flag{% endtrans %}"></a>
        <a{% if app.request.locale == 'en' %} class="active"{% endif %} href="{{ path(current_route|default('app_homepage'), {_locale: 'en', slug: current_route_slug|default(null)}) }}"><img src="{{ asset('build/images/base/english-flag.png') }}" alt="{% trans from "alt" %}english-flag{% endtrans %}"></a>
    </div>
</header>