{% extends 'layout.html.twig' %}

{% block title %}Prendre contact avec nous !{% endblock %}

{% block main %}

<section class="section-container">
    <section class="section-form">
        <h2 class="section-form-title">{% trans from "contact" %}contact.title{% endtrans %}</h2>
        {{ form(form) }}
    </section>
</section>

<div>
    <iframe class="streetmap" frameborder="0" allowfullscreen src="//umap.openstreetmap.fr/fr/map/streetmap-idci-2_804249?scaleControl=false&miniMap=false&scrollWheelZoom=false&zoomControl=true&allowEdit=false&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=undefined&captionBar=false"></iframe>
</div>

{% endblock %}