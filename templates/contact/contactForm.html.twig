{% form_theme form 'idci_form_fields.html.twig' %}

<form action="{{ url('website_contact') }}" method="post" novalidate>
    {{ form_widget(form) }}
</form>
<script>
    document.querySelectorAll('a.close').forEach(function (close) {
        close.addEventListener('click', closeError);
    });

    function closeError(event) {
        event.preventDefault();
        this.parentElement.style.display = "none";
    }
</script>
