<article class={{ class }}>
    <a href="#" class="accordion-toggle hide-for-medium-up">
        <div class="row">
            <div class="small-8 columns">
                <i class="fa fa-area-chart picture"></i>
                {{ title }}
            </div>
            <div class="small-2 columns toggle-icon">
                <i class="fa fa-angle-down"></i>
            </div>
        </div>
    </a>
    <div class="accordion-content">
        <h2 class="title">{{ title }}</h2>
        <p class="text-justify">
            {{ content }}
        </p>
        <a href="#" class="button small radius">En savoir +</a>
    </div>
</article>