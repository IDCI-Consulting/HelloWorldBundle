<article class="{{ class }} small-12 columns">
    <div class="row accordion-toggle hide-for-medium-up">
        <h3 class="small-8 columns">
            <i class="{{ fa_class }} picture"></i>
            {{ title|trans }}
        </h3>
        <div class="small-2 columns toggle-icon">
            <i class="fa fa-angle-down"></i>
        </div>
    </div>
    <div class="accordion-content row">
        <div class="medium-5 columns">
            <img class="hide-for-small-only" src="{{ asset(imageUrl) }}" />
        </div>
        <div class="medium-7 columns">
            <h2 class="hide-for-small-only">{{ title|trans }}</h2>
            <p>
                {{ content }}
            </p>
            <a class="button small">{% trans %}learn more{% endtrans %}</a>
        </div>
    </div>
</article>