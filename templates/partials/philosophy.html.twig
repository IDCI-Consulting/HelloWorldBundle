<article class="{{ class }} small-12 columns">
    <header>
        <h3 class="capitalize">{{ title|trans }}</h3>
    </header>
    <div class="row">
        <div class="medium-4 large-3 columns">
            <img src="{{ asset('images/formations.jpg') }}" />
        </div>
        <div class="medium-8 large-9 columns">
            <p>
                {{ content }}
            </p>
        </div>
    </div>
</article>