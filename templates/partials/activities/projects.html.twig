<section id="{% trans %}achievements{% endtrans %}" class="row full-width">
    <header class="small-8 medium-12 columns accordion-toggle open">
        <div class="row">
            <h2 class="small-10 medium-12 columns">
                {% trans %}our achievements{% endtrans %}
                <i class="hide-for-medium-up fa fa-desktop picture"></i>
            </h2>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-up"></i>
            </div>
        </div>
    </header>

    <div class="medium-12 columns accordion-content projects-content">
        <div class="projects">
            <div class="project">
                <div class="medium-6 large-4 columns">
                    <div class="browser-mockup">
                        <img src="{{ asset('images/moniteur.png') }}" />
                    </div>
                </div>
                <div class="medium-6 large-8 columns">
                    {% include 'contents/activities/moniteur_' ~ app.translator.locale ~ '.html.twig' %}
                </div>
            </div>
            <div class="project">
                <div class="medium-6 large-4 columns">
                    <div class="browser-mockup">
                        <img src="{{ asset('images/body.png') }}" />
                    </div>
                </div>
                <div class="medium-6 large-8 columns">
                    {% include 'contents/activities/bodysculpt_' ~ app.translator.locale ~ '.html.twig' %}
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    $(document).ready(function() {
        $('.projects').slick({
            inifinite: true,
            nextArrow: '<img class="slick-arrow next right" src="{{ asset('images/slick_arrow.svg') }}"/>',
            prevArrow: false
        });
    });
</script>