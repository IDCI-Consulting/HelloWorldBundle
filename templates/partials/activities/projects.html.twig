<section id="{% trans %}achievements{% endtrans %}" class="row full-width">
    <header class="small-8 medium-12 columns accordion-toggle open">
        <div class="row">
            <h1 class="small-10 medium-12 columns title">
                {% trans %}our achievements{% endtrans %}
            </h1>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-up"></i>
            </div>
        </div>
    </header>

    <div class="medium-12 columns accordion-content projects-content">
        {% for achievement in achievements %}
            {% if achievement.enabled %}
                <div class="realisation">
                    <div class="browser-mockup">
                        <img src="{{ achievement.image_path }}" />
                        <a class="with-url" href="{{ achievement.url }}" target="_blank">{{ achievement.url }}</a>
                    </div>
                    <a class="project-url" href="{{ achievement.url }}" target="_blank">{{ achievement.url }}</a>
                    <h4>{% trans %}The project{% endtrans %}</h4>
                    <p>{{ achievement.content[app.translator.locale]}}</p>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</section>
