<section id="{% trans %}achievements{% endtrans %}" class="row full-width">
    <header class="small-8 medium-12 columns accordion-toggle open">
        <div class="row">
            <h2 class="small-10 medium-12 columns">
                {% trans %}our achievements{% endtrans %}
            </h2>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-up"></i>
            </div>
        </div>
    </header>

    <div class="medium-12 columns accordion-content projects-content">
        {% for realisation in realisations %}
            <div class="realisation">
                {{ realisation|raw }}
            </div>
        {% endfor %}
    </div>
</section>

<script type="text/javascript">
    $(document).ready(function() {
        $('.projects-content').slick({
            autoplay: true,
            autoplaySpeed: 2000,
            inifinite: true,
            nextArrow: '<img class="slick-arrow next right" src="{{ asset('images/slick_arrow.svg') }}"/>',
            prevArrow: false
        });
    });
</script>