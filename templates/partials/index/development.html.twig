<section id="{% trans %}web-development{% endtrans %}" class="row full-width development">
    <header class="small-8 medium-12 columns accordion-toggle">
        <div class="row">
            <h3 class="hide-for-small-only">{% transchoice 2 from "messages" %}We do{% endtranschoice %}</h3>

            <h2 class="small-10 medium-12 columns">
                {% trans %}Web development{% endtrans %}
                <div class="show-for-small-only accordion-image">
                    <img src="{{ asset("images/icon_dev.svg") }}"/>
                </div>
            </h2>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-down"></i>
            </div>
        </div>
    </header>

    <div class="small-12 medium-10 medium-pull-1 large-8 large-pull-2 columns accordion-content">
        <div class="row">
            <div class="hide-for-small-only medium-8 medium-push-2 large-8 large-push-2 columns illustration">
                <pre id="editor"></pre>
            </div>
            <div class="medium-10 medium-pull-1 large-8 large-pull-2 columns idci-content">
                {% include 'contents/index/development_' ~ app.translator.locale ~ '.html.twig' %}
            </div>
        </div>
    </div>
    {% block experience_scripts %}{% endblock %}
</section>