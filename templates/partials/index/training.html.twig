<section id="{% trans %}training{% endtrans %}" class="trainings ">
    <header class="row accordion-toggle">
        <h3 class="hide-for-small-only medium-12 columns idci-green">{% trans %}We do{% endtrans %}</h3>
        <h2 class="small-10 medium-12 columns">
            {% trans %}Training{% endtrans %}
            <i class="hide-for-medium-up fa fa-comment picture"></i>
        </h2>
        <div class="hide-for-medium-up small-2 columns toggle-icon">
            <i class="fa fa-angle-down"></i>
        </div>
    </header>

    <div class="row accordion-content ">
        <div class="hide-for-small-only  medium-12 columns illustration">
            <img src="{{ asset("images/formations.jpg") }}" />
        </div>
        <div class="medium-12 columns">
            {% include 'contents/index/training_' ~ app.translator.locale ~ '.html.twig' %}
        </div>
    </div>
</section>