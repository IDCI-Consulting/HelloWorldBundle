<section id="{% trans %}advice{% endtrans %}" class="advices">
    <header class="accordion-toggle row">
        <h2 class="small-10 columns">
            {% trans %}Advices{% endtrans %}
            <i class="hide-for-medium-up fa fa-comment picture"></i>
        </h2>
        <div class="hide-for-medium-up small-2 columns toggle-icon">
            <i class="fa fa-angle-down"></i>
        </div>
    </header>

    <div class="row accordion-content">
        <div class="hide-for-small-only medium-5 columns illustration">
            <img src="{{ asset("images/conseils.jpg") }}" />
        </div>
        <div class="medium-7 columns">
            {% include 'contents/index/advice_' ~ app.translator.locale ~ '.html.twig' %}
        </div>
    </div>
</section>