<section id="{% trans %}philosophy{% endtrans %}" class="row full-width">
    <header class="small-8 medium-12 columns accordion-toggle">
        <div class="row">
            <em class="hide-for-small-only medium-12 columns sub-title">{% trans %}Our philosophy{% endtrans %}</em>
            <h2 class="small-10 medium-12 columns">
                Open source

                <img src="{{ asset('images/opensource.svg') }}" class="show-for-small-only accordion-image" alt="{% trans %}opensource icon{% endtrans %}" style="margin-top: 1.5rem;"/>
            </h2>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-down"></i>
            </div>
        </div>
    </header>

    <div class="small-12 medium-10 medium-pull-1 large-8 large-pull-2 columns accordion-content">
        <div class="row">
            <div class="hide-for-small-only medium-8 medium-push-2 large-8 large-push-2 columns illustration">
                <img src="{{ asset('images/opensource.svg') }}" alt="{% trans %}opensource icon{% endtrans %}"/>
            </div>
            <div class="medium-10 medium-pull-1 large-8 large-pull-2 columns idci-content">
                {% include 'contents/index/philosophy_' ~ app.translator.locale ~ '.html.twig' %}
            </div>
        </div>
    </div>
</section>