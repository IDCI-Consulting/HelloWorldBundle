<section id="{% trans %}presentation{% endtrans %}" class="full-width">
    <div class="row">
        <header class="medium-12 columns">
            <div class="row">
                <em class="medium-12 columns sub-title">{% trans %}We specialize in{% endtrans %}</em>
                <h2 class="small-12 columns">
                    {% trans %}Web architecture{% endtrans %}, {% trans %}PHP{% endtrans %} & {% trans %}
                    Symfony{% endtrans %}
                </h2>
            </div>
        </header>

        <div class="small-12 medium-12 columns">
            <div class="row">
                <div class="medium-10 medium-push-1 columns acronym">
                    <p>
                        <span>&lt;{% trans %}Engineering{% endtrans %}&gt;</span>
                    </p>
                    <p>
                        <span>&lt;{% trans %}Development{% endtrans %}&gt;</span>
                    </p>
                    <p>
                        <span>&lt;{% trans %}Consulting{% endtrans %}&gt;</span>
                    </p>
                    <p>
                        <span>&lt;{% trans %}Integration{% endtrans %}&gt;</span>
                    </p>
                </div>
                <div class="hide-for-small-only medium-12 columns">
                    <a href="#{% trans %}advice{% endtrans %}" class="scroll-to">
                        <span></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>