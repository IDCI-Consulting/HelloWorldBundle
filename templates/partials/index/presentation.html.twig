<section id="{% trans %}presentation{% endtrans %}" class="full-width">
    <div class="row">
        <header class="medium-12 columns">
            <div class="row">
                <h3 class="medium-12 columns">{% trans %}We specialize in{% endtrans %}</h3>

                <h2 class="small-12 columns">
                    {% trans %}Web architecture{% endtrans %}, {% trans %}PHP{% endtrans %} & {% trans %}
                    Symfony{% endtrans %}
                </h2>
            </div>
        </header>

        <div class="small-12 medium-12 columns">
            <div class="row">
                <div class="medium-10 medium-push-1 columns acronym">
                    <p>&lt;<span>{% trans %}Engineering{% endtrans %}</span>&gt;</p>

                    <p>&lt;<span>{% trans %}Development{% endtrans %}</span>&gt;</p>

                    <p>&lt;<span>{% trans %}Advices{% endtrans %}</span>&gt;</p>

                    <p>&lt;<span>{% trans %}Integration{% endtrans %}</span>&gt;</p>
                </div>
                <div class="hide-for-small-only medium-12 columns">
                    <a href="#{% trans %}training{% endtrans %}" class="scroll-to">
                        <span></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>