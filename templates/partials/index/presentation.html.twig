<article class="{% block presentation_class %}{% endblock %} small-12 columns">
    <header>
        {% block presentation_title %}{% endblock %}
    </header>
    <div class="row">
        <div class="medium-4 large-3 columns">
            {% block presentation_image %}{% endblock %}
        </div>
        <div class="medium-8 large-9 columns">
            {% block presentation_content %}{% endblock %}
        </div>
    </div>
</article>