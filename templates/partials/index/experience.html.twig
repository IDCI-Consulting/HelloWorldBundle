<article class="{% block experience_class %}{% endblock %} small-12 columns">
    <div class="row accordion-toggle hide-for-medium-up">
        <h3 class="small-8 columns">
            {% block experience_icon %}{% endblock %}
            {% block experience_accordion_title %}{% endblock %}
        </h3>
        <div class="small-2 columns toggle-icon">
            <i class="fa fa-angle-down"></i>
        </div>
    </div>
    <div class="accordion-content row">
        <div class="medium-5 columns">
            {% block experience_image %}{% endblock %}
        </div>
        <div class="medium-7 columns">
            <h2 class="hide-for-small-only">{% block experience_title %}{% endblock %}</h2>
            {% block experience_content %}{% endblock %}
            <a class="button small learn-more">{% trans %}learn more{% endtrans %}</a>
        </div>
    </div>
    {% block experience_scripts %}{% endblock %}
</article>
