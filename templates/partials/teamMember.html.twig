<section class="member">
    <header>
        <h2 class="show-for-small idci-light-blue capitalize">{{ firstName }} {{ lastName }}</h2>

        <p class="show-for-small ">{{ profession|trans }}</p>
    </header>

    <div class="content-wrapper">
        <div class="image-holder {{ firstName }}">
            <div class="profile-picture front"></div>
        </div>
    </div>

    <ul class="show-for-small skills">
        {% for skill in skills %}
            <li class="skill">
                <img src="{{ asset('images/idci_list_style.png') }}" />
                <span>{{ skill|trans }}</span>
            </li>
        {% endfor %}
    </ul>

    <p class="member-description">
        {{ description }}
    </p>

    <a href="{{ path('cv', {_locale: app.translator.locale, 'name': firstName}) }}" class="button small see-cv">CV</a>
</section>