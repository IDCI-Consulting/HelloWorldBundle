<section id="{% trans %}last-articles{% endtrans %}" class="last-articles full-width">
    <div class="row">
        <header class="small-8 medium-12 columns accordion-toggle open">
            <div class="row">
                <h2 class="small-10 medium-12 columns">
                    {% trans %}last articles{% endtrans %}
                </h2>
                <div class="hide-for-medium-up small-2 columns toggle-icon">
                    <i class="fa fa-angle-up"></i>
                </div>
            </div>
        </header>

        <div class="medium-12 columns accordion-content articles">
            {% for article in last_articles|slice(0, 5) %}
                <div class="row">
                    <div class="small-12 columns info">
                        <span>{{ article['date'] }}</span>
                        <span>{{ article['author'] }}</span>
                    </div>
                    <div class="small-3 columns">
                        <img src="{{ asset('images/blog/'~article['image']~'') }}" />
                    </div>
                    <div class="small-9 columns title">
                        <p>{{ article['title'] }}</p>
                    </div>
                    <div class="small-3 columns end read-article">
                        <a href="{{ path('article', {_locale: app.translator.locale, file: article['file']}) }}">Lire l'article</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script type="text/javascript">
    $(document).ready(function() {
        $('.articles').slick({
            inifinite: true,
            nextArrow: '<img class="slick-arrow next right" src="{{ asset('images/slick_arrow.svg') }}"/>',
            prevArrow: false,
            autoplay: true,
            autoplaySpeed: 10000
        });
    });
</script>