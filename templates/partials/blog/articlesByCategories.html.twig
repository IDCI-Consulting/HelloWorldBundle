<div id="{% trans %}articles-by-categories{% endtrans %}" class="by-categories full-width">
    <div class="row">
        <header class="small-8 medium-12 columns accordion-toggle">
            <div class="row">
            <h2 class="hide-for-medium-up small-10 columns">{% trans %}All articles{% endtrans %}</h2>
                <div class="hide-for-medium-up small-2 columns toggle-icon">
                    <i class="fa fa-angle-down"></i>
                </div>
            </div>
        </header>

        <div class="small-12 columns accordion-content">
            <div class="row">
                {% for category, articles in articles_by_categories %}
                    <div class="small-12 columns category"><p>{{ category }}</p></div>
                    {% for article in articles %}
                        <div class="small-12 columns article">
                            <div class="row" {% if article['image'] is defined %} style="background-image: url('/images/blog/{{ article['image'] }}');"{% endif %}>
                                <a class="small-10 small-push-2 medium-11 columns" href="{{ path('article', {_locale: app.translator.locale, 'file': article['file']}) }}">
                                    {{ article['title'] }} <em>{% trans %}added at{% endtrans %} {{ article['date']|date('d/m/Y') }} {% trans %}by{% endtrans %} {{ article['author'] }}</em>
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
