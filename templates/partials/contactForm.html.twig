{% form_theme form 'idci_form_fields.html.twig' %}

<div class="row">
    <h2 class="title title-contact">{% trans %}Contact us{% endtrans %}</h2>
    <section class="content contact-form">
        <form class="row" action="{{ path('contactForm', {_locale: app.translator.locale}) }}" method="post">
            {{ form_widget(form) }}
            <button type="submit" class="button--submit button--quidel" name="submit">
                <span>Valider</span>
            </button>
        </form>
    </section>
</div>