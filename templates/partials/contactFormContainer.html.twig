<div class="small-12 columns content contact-form">
    <div class="form-container">
        {% include 'partials/contactForm.html.twig' with {'form': form} %}
    </div>

    <script type="text/javascript">

        $(document).ready(function() {
            var $output = $('<div id="output"></div>');
            var $formContainer = $('.form-container');
            $formContainer.after($output);

            $formContainer.on('submit', 'form', function(event) {
                event.preventDefault();

                $output.html('<img class="ajax-loader" src="{{ asset('images/ajaxLoader.gif') }}" />');
                var request = $.ajax({
                    url: $(this).attr('action'),
                    method: $(this).attr('method'),
                    data: $(this).serialize(),
                    dataType: "html"
                });

                request.done(function(content, textStatus, xhr) {
                    $output.empty();
                    var statusCode = xhr.statusCode().status;

                    if (xhr.getResponseHeader('X-Message')) {
                        $.notify(xhr.getResponseHeader('X-Level'), xhr.getResponseHeader('X-Message').decode());
                    }

                    if (201 !== parseInt(statusCode)) {
                        $formContainer.html(content);
                    } else {
                        $formContainer.find('form').get(0).reset();
                    }
                });

                request.fail(function(xhr, textStatus) {
                    console.log("Request failed: " + textStatus);
                });
            });
        });


    </script>
</div>
