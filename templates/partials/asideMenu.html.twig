{% if aside_menu is defined %}
    <ul class="hide-for-small-only aside-navigation-menu">
        {% for id, title in  aside_menu %}
            <li>
                <a href="#{{ id }}" class="aside-navigation-link">
                    {{ title }}
                    <span class="idci-circle"></span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}