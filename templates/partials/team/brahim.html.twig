    <a href="{{ path('cv', {_locale: app.translator.locale, 'theme': 'idci', 'name': 'brahim_boukoufallah'}) }}" class="button small see-cv small-12">{% transchoice 2 from "messages" %}See{% endtranschoice %} CV</a>
</article>