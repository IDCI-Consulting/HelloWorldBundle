<article class="small-12 medium-4 columns member">
    <header>
        <h3 class="member-name">Brahim Boukoufallah</h3>

        <p class="job-position">{% trans %}Developer{% endtrans %}</p>
    </header>

    <div class="content-wrapper">
        <div class="image-holder brahim">
            <div class="profile-picture front"></div>
        </div>
    </div>

    {% filter markdown %}
