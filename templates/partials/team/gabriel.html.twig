<section class="small-12 medium-6 columns member">
    <header>
        <h2 class="idci-light-blue capitalize">Gabriel Bondaz</h2>

        <p>{% trans %}Développeur expert{% endtrans %}</p>
    </header>

    <div class="content-wrapper">
        <div class="image-holder {{ firstName }}">
            <div class="profile-picture front"></div>
        </div>
    </div>

    <ul class="show-for-small skills">
        {% for skill in skills %}
            <li class="skill">
                <img src="{{ asset('images/idci_list_style.png') }}" />
                <span>{{ skill|trans }}</span>
            </li>
        {% endfor %}
    </ul>

    {% include 'contents/team/gabriel_' ~ app.translator.locale ~ '.html.twig' %}

    <a href="{{ path('cv', {_locale: app.translator.locale, 'name': 'gabriel_bondaz'}) }}" class="button small see-cv">CV</a>
</section>