<article class="small-12 medium-6 large-4 columns member">
    <header>
        <h2 class="member-name">Eddie Barraco</h2>

        <em class="job-position">{% trans %}Developer{% endtrans %}</em>
    </header>

    <div class="content-wrapper">
        <div class="image-holder eddie">
            <div class="profile-picture front"></div>
        </div>
    </div>

    <div class="member-description">
        {% filter markdown %}
        {% include 'contents/team/eddie_' ~ app.translator.locale ~ '.md' %}
        {% endfilter %}
    </div>


    {% if file_exists('templates/contents/cv/eddie_barraco_'~app.translator.locale~'.md') %}
        <a href="{{ path('cv', {_locale: app.translator.locale, 'theme': app.config.cv_theme, 'name': 'eddie_barraco_'~app.translator.locale}) }}" class="button small small-12 see-cv">{% transchoice 2 from "messages" %}See{% endtranschoice %} CV</a>
    {% endif %}
</article>
