<section class="member small-12 medium-6 columns">
    <header>
        <h2 class="idci-light-blue capitalize">{% block team_member_name %}{% endblock %}</h2>

        <p>{% block team_member_profession %}{% endblock %}</p>
    </header>

    <div class="content-wrapper">
        <div class="image-holder {{ firstName }}">
            <div class="profile-picture front"></div>
        </div>
    </div>

    <ul class="show-for-small skills">
        {% for skill in skills %}
            <li class="skill">
                <img src="{{ asset('images/idci_list_style.png') }}" />
                <span>{{ skill|trans }}</span>
            </li>
        {% endfor %}
    </ul>


    {% block team_member_description %}{% endblock %}

    {% block team_member_cv_link %}{% endblock %}
</section>