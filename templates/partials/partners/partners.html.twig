<section id="{% trans %}partner{% endtrans %}" class="row full-width partners">
    <header class="small-8 medium-12 columns accordion-toggle open">
        <div class="row">
            <h1 class="small-10 medium-12 columns title">
                {% trans %}Our partners{% endtrans %}
            </h1>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-up"></i>
            </div>
        </div>
    </header>

    <div class="medium-12 columns accordion-content partners-content">
        <div>
            <ul class="row partners">
                {% for partner in partners %}
                    <li class="small-12 medium-6 large-3">
                        <a href="{{ partner['link'] }}" target="_blank" class="partner">
                            <div>
                                <span class="{{ partner['class'] }}"></span>
                                <div>
                                    <h3>{{ partner['name'] }}</h3>
                                    <p>{{ partner['description'] }}</p>
                                </div>
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</section>
