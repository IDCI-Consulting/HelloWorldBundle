<article>
    {% if company is defined %}
        <header>La societe: {{ company }}</header>
    {% endif %}

    <p>{{ name }} {{ firstName }} souhaite vous contacter.</p>
    <p>La description de son projet est ci-dessous:</p>
    <p>{{ project }}</p>

    <footer>
        <p>Contact du contact :</p>
        <p>email: <a href="mailto:{{ email }}">{{ email }}</a></p>
        <p>telephone: <a href="tel:{{ phoneNumber }}">{{ phoneNumber }}</a></p>
    </footer>
</article>