<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
        <link
            {% if format == 'pdf' %}
                href="{{ app.request_stack.getCurrentRequest().getScheme() }}://idci-website-nginx{{ asset('css/' ~ getRevFilename('app.min.css') ~ '') }}"
            {% else %}
                href="{{ asset('css/' ~ getRevFilename('app.min.css') ~ '') }}"
            {% endif %}
            rel="stylesheet"
            type="text/css"
        />
    </head>

    <body>
        <div class="content course-content">
            {{ course|markdown }}
        </div>
    </body>
</html>
