<section id="{% trans %}course{% endtrans %}" class="row full-width courses">
    <header class="small-8 medium-12 columns accordion-toggle">
        <div class="row">
            <h3 class="hide-for-small-only medium-12">{% trans %}Choose one of{% endtrans %}</h3>
            <!--<span class="hide-for-small-only arrow"><img src="{{ asset("images/balise_left.svg") }}"></span>-->
            <h2 class="small-10 medium-12 columns idci-courses">
                {% trans %}Our courses{% endtrans %}
                <i class="hide-for-medium-up fa fa-book picture"></i>
            </h2>
            <!--<span class="hide-for-small-only arrow"><img src="{{ asset("images/balise_right.svg") }}"></span>-->
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-down"></i>
            </div>
        </div>
    </header>

    <div class="small-12 columns accordion-content course-boxes">
        <div class="row">
            <div class="medium-10 medium-push-1 columns">
                <div class="row">
                    <div class="small-6 medium-6 columns">
                        <div class="course-box">
                            <img src="{{ asset('images/opensource.svg') }}" />
                            <p>poo - uml - merise - scm</p>
                        </div>
                    </div>
                    <div class="small-6 medium-6 columns">
                        <div class="course-box">
                            <img src="{{ asset('images/opensource.svg') }}" />
                            <p>html5 / css3</p>
                        </div>
                    </div>
                    <div class="small-6 medium-6 columns">
                        <div class="course-box">
                            <img src="{{ asset('images/opensource.svg') }}" />
                            <p>symfony2</p>
                        </div>
                    </div>
                    <div class="small-6 medium-6 columns">
                        <div class="course-box">
                            <img src="{{ asset('images/opensource.svg') }}" />
                            <p>wordpress</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
