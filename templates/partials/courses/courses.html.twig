<section id="{% trans %}course{% endtrans %}" class="row full-width">
    <header class="small-8 medium-12 columns accordion-toggle">
        <div class="row">
            <em class="hide-for-small-only medium-12 sub-title">{% trans %}Choose one of{% endtrans %}</em>
            <!--<span class="hide-for-small-only arrow"><img src="{{ asset("images/balise_left.svg") }}"></span>-->
            <h1 class="small-10 medium-12 columns idci-courses title">
                {% trans %}Our courses{% endtrans %}
            </h1>
            <!--<span class="hide-for-small-only arrow"><img src="{{ asset("images/balise_right.svg") }}"></span>-->
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-down"></i>
            </div>
        </div>
    </header>

    <div class="small-12 columns accordion-content course-boxes">
        <div class="row">
            <div class="medium-10 medium-push-1 columns">
                <div class="row">
                    <div class="small-6 large-3 columns">
                        <div class="course-box">
                            <a href="#oop-uml-scm" class="scroll-to">
                                <img src="{{ asset('images/oop-uml-scm.svg') }}" alt="{% trans %}oop uml image{% endtrans %}"/>
                                <p>oop - uml - scm</p>
                            </a>
                        </div>
                    </div>
                    <div class="small-6 large-3 columns">
                        <div class="course-box">
                            <a href="#html5-css3" class="scroll-to">
                                <img src="{{ asset('images/html5-css3.svg') }}" alt="{% trans %}html5 css3 image{% endtrans %}"/>
                                <p>html5 / css3</p>
                            </a>
                        </div>
                    </div>
                    <div class="small-6 large-3 columns">
                        <div class="course-box">
                            <a href="#symfony2" class="scroll-to">
                                <img src="{{ asset('images/symfony2.svg') }}" alt="{% trans %}symfony2 image{% endtrans %}"/>
                                <p>PHP - symfony2</p>
                            </a>
                        </div>
                    </div>
                    <div class="small-6 large-3 columns">
                        <div class="course-box">
                            <a href="#wordpress" class="scroll-to">
                                <img src="{{ asset('images/wordpress.svg') }}" alt="{% trans %}wordpress image{% endtrans %}"/>
                                <p>PHP - wordpress</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
