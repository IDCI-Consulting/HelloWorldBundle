{% for title, courses in tabs_course_menu %}
    <section id="{{ title }}" class="row full-width">
        <header class="small-8 medium-12 columns accordion-toggle">
            <div class="row">
                <h2 class="small-10 medium-12 columns course-name">
                    {{ title }}
                    <a href="{{ path('contact', {_locale: app.translator.locale}) }}" class="button small hide-for-small-only contact-us">{% trans %}Contact us{% endtrans %}</a>
                </h2>
                <div class="hide-for-medium-up small-2 columns toggle-icon">
                    <i class="fa fa-angle-down"></i>
                </div>
            </div>
        </header>

        {# Break the accordion in mobile screen #}
        <div class="large-4 columns hide-for-medium-down course-logo">
            <img src="{{ asset('images/'~ title ~'.svg') }}" />
        </div>
        <div class="small-12 large-8 columns accordion-content">

            {% if courses['description'] is defined %}
                <p class="course-description">{{ courses['description'] }}</p>
            {% endif %}

            <ul class="tabs" data-tab>
                {% for day, courseContent in courses['courses'] %}
                    <li class="tab-title"><a href="#{{ title|trim }}-{{ day }}">{{ day|trans }}</a></li>
                {% endfor %}
            </ul>

            <div class="tabs-content">
                {% for day, courseContent in courses['courses'] %}
                <div class="content" id="{{ title }}-{{ day }}">
                    {{ courseContent|markdown }}
                </div>
                {% endfor %}
            </div>

            <a href="{{ path('course', {"_locale": app.translator.locale, "name": title, "_format": 'pdf'}) }}" class="button small">
                {% trans %}download{% endtrans %}
            </a>
        </div>
    </section>
{% endfor %}
<script type="text/javascript">
    $(document).ready(function() {
        $('.tabs li:first-child').addClass('active');

        $('div.tabs-content > div:first-child').addClass('active on');

        $('.tabs').on('click', 'li', function(event) {
            $('.tabs-content').find('.content').removeClass('on');
            $('.content.active').fadeIn('slow').addClass('on');
        });
    });

</script>
