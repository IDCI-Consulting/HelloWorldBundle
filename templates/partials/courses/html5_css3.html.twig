<section id="{% trans %}html5-css3{% endtrans %}" class="row full-width">
    <header class="small-8 medium-12 columns accordion-toggle">
        <div class="row">
            <h2 class="small-10 medium-12 columns">
                Html5/Css3
                <i class="hide-for-medium-up fa fa-comment picture"></i>
            </h2>
            <div class="hide-for-medium-up small-2 columns toggle-icon">
                <i class="fa fa-angle-down"></i>
            </div>
        </div>
    </header>

    <div class="small-12 medium-10 medium-push-2 columns accordion-content">
        <ul class="tabs" data-tab>
            <li class="tab-title active"><a href="#html5-css3-day1">{% trans %}Day 1{% endtrans %}</a></li>
            <li class="tab-title"><a href="#html5-css3-day2">{% trans %}Day 2{% endtrans %}</a></li>
            <li class="tab-title"><a href="#html5-css3-day3">{% trans %}Day 3{% endtrans %}</a></li>
            <li class="tab-title"><a href="#html5-css3-day4">{% trans %}Day 4{% endtrans %}</a></li>
            <li class="tab-title"><a href="#html5-css3-day5">{% trans %}Day 5{% endtrans %}</a></li>
        </ul>

        <div class="tabs-content">
            <div class="content active" id="html5-css3-day1">
                {% filter markdown %}
                {% include 'contents/courses/html5_css3/day1.md.twig' %}
                {% endfilter %}
            </div>
            <div class="content" id="html5-css3-day2">
                {% filter markdown %}
                {% include 'contents/courses/html5_css3/day2.md.twig' %}
                {% endfilter %}
            </div>
            <div class="content" id="html5-css3-day3">
                {% filter markdown %}
                {% include 'contents/courses/html5_css3/day3.md.twig' %}
                {% endfilter %}
            </div>
            <div class="content" id="html5-css3-day4">
                {% filter markdown %}
                {% include 'contents/courses/html5_css3/day4.md.twig' %}
                {% endfilter %}
            </div>
            <div class="content" id="html5-css3-day5">
                {% filter markdown %}
                {% include 'contents/courses/html5_css3/day5.md.twig' %}
                {% endfilter %}
            </div>
        </div>
    </div>
</section>