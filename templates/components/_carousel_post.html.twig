<div class="carousel-post">
    <img src="{{ asset('build/images/' ~ post_media) }}" class="carousel-post-media">
    <div class="carousel-post-content">
        <div class="carousel-post-content-header">
            <p>{{ post_publication_date }}</p>
        </div>
        <h3 class="carousel-post-content-title">{{ post_title }}</h3>
        <p class="carousel-post-content-description">{{ post_description }}</p>
        <a href="{{ post_href }}" class="button carousel-post-content-button">{{ 'blog.read_post'|trans({}, 'blog') }}</a>
    </div>
</div>
